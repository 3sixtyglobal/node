{
	"language": "en-GB",
	"ignorePaths": [
		"**/node_modules/**",
		"LICENSE",
		"**/coverage/**",
		"**/dist/**",
		"**/docs/reference/**",
		"**/docs/open-api/**",
		"**/tests/**",
		"*.yaml",
		"*.svg",
		"package.json",
		"rollup.config.mjs",
		"vitest.config.*",
		"tsconfig.json",
		"typedoc.json",
		"eslint.config*",
		"**/wordlists/**",
		"changelog.md"
	],
	"words": [
		"abbrev",
		"autorelease",
		"bech",
		"behavior",
		"buildx",
		"certbot",
		"cosmosdb",
		"crosshair",
		"DARP",
		"dialogs",
		"faucet",
		"firestore",
		"firestoredb",
		"ipfs",
		"Millis",
		"nameof",
		"odrl",
		"Phytosanitary",
		"PNAP",
		"PNRP",
		"scylladb",
		"Stiftung",
		"swatchbook",
		"txblock",
		"Unece",
		"whereis"
	],
	"ignoreRegExpList": [
		"/from\\s+(['\"]).*\\1/",
		"/eslint-disable.*/",
		"/^```shell[\\s\\S]*?```$/gm",
		"/^```json[\\s\\S]*?```$/gm",
		"/^```shell[\\s\\S]*?```$/gm",
		"/^```json[\\s\\S]*?```$/gm"
	]
}
