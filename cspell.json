{
	"language": "en-GB",
	"ignorePaths": [
		"**/node_modules/**",
		"LICENSE",
		"**/coverage/**",
		"**/dist/**",
		"**/docs/reference/**",
		"**/docs/open-api/**",
		"**/tests/**",
		"*.yaml",
		"*.svg",
		"package.json",
		"vitest.config.*",
		"tsconfig.json",
		"tsconfig.eslint.json",
		"typedoc.json",
		"eslint.config*",
		"**/wordlists/**",
		"changelog.md"
	],
	"words": [
		"abbrev",
		"aabb",
		"autorelease",
		"bech",
		"behavior",
		"buildx",
		"CEFACT",
		"certbot",
		"cosmosdb",
		"crosshair",
		"Dataspace",
		"Dcat",
		"dialogs",
		"faucet",
		"firestore",
		"firestoredb",
		"Foaf",
		"ipfs",
		"Millis",
		"nameof",
		"odrl",
		"Phytosanitary",
		"PNAP",
		"PNRP",
		"scylladb",
		"Stiftung",
		"swatchbook",
		"txblock",
		"twinfoundation",
		"GTSC",
		"TLIP",
		"Unece",
		"whereis",
		"postgre",
		"Math",
		"decgbytes",
		"decmbytes",
		"timepicker",
		"timezone"
	],
	"ignoreRegExpList": [
		"/from\\s+(['\"]).*\\1/",
		"/eslint-disable.*/",
		"/^```typescript[\\s\\S]*?```$/gm",
		"/^```ts[\\s\\S]*?```$/gm",
		"/^```shell[\\s\\S]*?```$/gm",
		"/^```json[\\s\\S]*?```$/gm",
		"/<M>[\\s\\S]*?<\\/M>/g",
		"/<code>[\\s\\S]*?<\\/code>/g"
	]
}
