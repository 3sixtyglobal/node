## The features to enable on the node
##   admin-user: generates an admin user for the node if not provided in config.
##   wallet: generates a wallet for the node if a faucet is available.
# TWIN_FEATURES="admin-user,wallet"

# Static tenant id which is used by the node, if empty a new node tenant will be created on first run
# TWIN_TENANT_ID=""

# Static tenant api key which is used by the node, if empty a new api key will be generated on first run
# TWIN_TENANT_API_KEY=""

# Identity Details

# Identity for Node
# TWIN_NODE_IDENTITY=""

# The Bip39 mnemonic for creating the seed for the node, defaults to randomly generated, check logs for the generated mnemonic
# TWIN_NODE_MNEMONIC=""

# Identity for Organisation, if not provided it will be generated
# TWIN_ORGANIZATION_IDENTITY=""

# The mnemonic for the organisation, if empty it will be randomly generated
# TWIN_ORGANIZATION_MNEMONIC=""

# Identity for the Node Admin User, if not provided it will be generated
# TWIN_ADMIN_USER_IDENTITY=""

# The mnemonic for the admin user, if empty it will be randomly generated
# TWIN_ADMIN_USER_MNEMONIC=""

# Username for Node admin login
# TWIN_ADMIN_USER_NAME="admin@node"

# Password for Node admin login, defaults to randomly generated, check logs for the generated password
# TWIN_ADMIN_USER_PASSWORD="yM5?NgPPAio+TmWx"
