# =============================================================================
# Kenya Community USE-CASE Node — single container, 5 tenants
#   Publishers: KRA, KPA, KENTRADE, AFA  •  Consumer: Trader
# =============================================================================
# Purpose: demonstrate the real Kenya shape — multiple authorities each PUBLISH
# their own consignment slice; one consumer (Trader) DISCOVERS all of them in
# the shared catalogue, NEGOTIATES + PULLS from each, and AGGREGATES locally.
# This is the DSP-native publish-and-aggregate model (no cross-tenant writes —
# that is a separate ticket). Distinct payloads per authority are served by the
# test app from a 4-consignment superset (TWIN_TEST_APP_CONSIGNMENTS below),
# each pull scoped by ?id=<authority consignment>.
#
# Port: 3000 (internal) / 3041 (host, distinct from kenya 3040 + mobius 3020-23)

# =============================================================================
# Web Server
# =============================================================================
TWIN_PORT=3000
TWIN_HOST="0.0.0.0"
TWIN_PUBLIC_ORIGIN="http://twin-kenya-usecase-node:3000"
TWIN_DEBUG=true

# =============================================================================
# Storage
# =============================================================================
TWIN_ENTITY_STORAGE_CONNECTOR_TYPE="file"
TWIN_STORAGE_FILE_ROOT="/app/data/"

# =============================================================================
# Multi-tenancy
# =============================================================================
TWIN_TENANT_ENABLED="true"

# Note: TWIN_TENANT_TOKEN_ENCRYPTION_KEY_ID defaults to "tenant-token-encryption"
# via getEnvDefaults (TICKET-C). Bootstrap creates the symmetric vault key under
# this name on the node identity; TenantProcessor + DSP + PNP all consume it.
# Override only if you need to verify a custom key name.

# =============================================================================
# URL Transformer — Martyn split this out of HostingService. Encrypts query
# params (notably tenant) on URLs minted into the catalogue distributions, so
# downstream nodes can resolve the right tenant partition without exposing it
# in cleartext. Required by rights-management-pnp + federated-catalogue-service
# at engine init.
# =============================================================================
TWIN_URL_TRANSFORMER_ENABLED="true"

# =============================================================================
# Health — kenya-test.sh asserts /health returns 401 keyless and 200 with the
# tenant api-key (Phase 1 sanity). Health was previously auto-mounted; after
# Martyn's component split it has to be opted in via env.
# =============================================================================
TWIN_HEALTH_ENABLED="true"

# =============================================================================
# Connectors
# =============================================================================
TWIN_IDENTITY_CONNECTOR="iota"
TWIN_IDENTITY_RESOLVER_CONNECTOR="iota"
TWIN_IDENTITY_PROFILE_CONNECTOR="entity-storage"
TWIN_VAULT_CONNECTOR="entity-storage"
TWIN_LOGGING_CONNECTOR="console,entity-storage"
TWIN_WALLET_CONNECTOR="iota"
TWIN_FAUCET_CONNECTOR="iota"
TWIN_NFT_CONNECTOR="entity-storage"
TWIN_EVENT_BUS_CONNECTOR="local"
TWIN_TELEMETRY_CONNECTOR="entity-storage"

# =============================================================================
# IOTA (only used for node DID bootstrap)
# =============================================================================
TWIN_IOTA_NODE_ENDPOINT="https://api.testnet.iota.cafe"
TWIN_IOTA_FAUCET_ENDPOINT="https://faucet.testnet.iota.cafe/api/enqueue"
TWIN_IOTA_NETWORK="testnet"

# =============================================================================
# Auth
# =============================================================================
TWIN_AUTH_ADMIN_PROCESSOR_TYPE="entity-storage"
TWIN_AUTH_PROCESSOR_TYPE="entity-storage"

# =============================================================================
# Trust — auto-enabled by node-core's configureTrust because dataspace +
# rights-management components are configured. Generators / verifiers / the
# trust-assertion VM still need to be configured explicitly.
# =============================================================================
TWIN_TRUST_GENERATORS="jwt-verifiable-credential"
TWIN_TRUST_VERIFIERS="jwt-verifiable-credential"
TWIN_TRUST_VERIFICATION_METHOD_ID="trust-assertion"
TWIN_TRUST_JWT_TTL_SECONDS="3600"

# =============================================================================
# Rights Management — full PNP path (TICKET-E exercises this). Auto-enabled
# via isRightsManagementRequired based on dataspace + sync-storage presence.
# =============================================================================
TWIN_RIGHTS_MANAGEMENT_CALLBACK_PATH="rights-management"
TWIN_RIGHTS_MANAGEMENT_POLICY_NEGOTIATORS="pass-through"
TWIN_RIGHTS_MANAGEMENT_POLICY_REQUESTERS="pass-through"
TWIN_RIGHTS_MANAGEMENT_POLICY_ENFORCEMENT_PROCESSORS="pass-through"
TWIN_RIGHTS_MANAGEMENT_POLICY_ARBITERS="pass-through"
TWIN_RIGHTS_MANAGEMENT_POLICY_OBLIGATION_ENFORCERS="pass-through"

# =============================================================================
# Federated Catalogue — partitioned [Node]-only (verified 2026-04-24), so
# discovery is shared across tenants on this single node. KRA's published
# offer must be visible to Trader without crossing into KRA's partition.
# =============================================================================
TWIN_FEDERATED_CATALOGUE_FILTERS="filter-by-example"

# =============================================================================
# Dataspace — control + data plane both enabled. TICKET-D wires the encrypted
# tenantToken into dataAddress.endpoint at the control plane.
# =============================================================================
TWIN_DATASPACE_ENABLED="true"
TWIN_DATASPACE_DATA_PLANE_PATH="dataspace/entities"

# =============================================================================
# Bootstrap
# =============================================================================
TWIN_FEATURES="node-identity,node-wallet,node-admin-user"

# =============================================================================
# Extensions — dataspace-test-app serves consignment data on pull. Here it is
# configured (TWIN_TEST_APP_CONSIGNMENTS) with a 4-consignment superset, one per
# authority, each with a distinct `id`. Each publisher registers its own dataset
# + ODRL offer (via provision-storage.sh); the consumer pulls each scoped by
# `?id=<authority consignment>` so the test app returns that authority's slice.
# `@json:` is expanded by node-core (node.ts) from a file resolved against the
# container execution dir (/app), so consignments.json must be COPY'd to /app.
# =============================================================================
TWIN_EXTENSIONS="@twin.org/dataspace-test-app"
TWIN_TEST_APP_CONSIGNMENTS="@json:consignments.json"
