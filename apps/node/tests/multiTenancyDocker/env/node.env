# =============================================================================
# Multi-tenant TWIN node — single container, multiple tenants
# =============================================================================
# Port: 3000 (internal) / 3030 (host)
# Service name: twin-mt-node

# =============================================================================
# Web Server
# =============================================================================
TWIN_PORT=3000
TWIN_HOST="0.0.0.0"
TWIN_PUBLIC_ORIGIN="http://twin-mt-node:3000"
TWIN_DEBUG=true

# =============================================================================
# Storage
# =============================================================================
TWIN_ENTITY_STORAGE_CONNECTOR_TYPE="file"
TWIN_STORAGE_FILE_ROOT="/app/data/"

# =============================================================================
# Multi-tenancy — THE toggle that enables this whole test
# =============================================================================
TWIN_TENANT_ENABLED="true"

# =============================================================================
# Connectors — IOTA for identity only; everything else entity-storage
# =============================================================================
TWIN_IDENTITY_CONNECTOR="iota"
TWIN_IDENTITY_RESOLVER_CONNECTOR="iota"
TWIN_IDENTITY_PROFILE_CONNECTOR="entity-storage"
TWIN_VAULT_CONNECTOR="entity-storage"
TWIN_LOGGING_CONNECTOR="console,entity-storage"
TWIN_WALLET_CONNECTOR="iota"
TWIN_FAUCET_CONNECTOR="iota"
TWIN_NFT_CONNECTOR="entity-storage"
TWIN_EVENT_BUS_CONNECTOR="local"
TWIN_TELEMETRY_CONNECTOR="entity-storage"

# =============================================================================
# IOTA (only used for node DID bootstrap)
# =============================================================================
TWIN_IOTA_NODE_ENDPOINT="https://api.testnet.iota.cafe"
TWIN_IOTA_FAUCET_ENDPOINT="https://faucet.testnet.iota.cafe/api/enqueue"
TWIN_IOTA_NETWORK="testnet"

# =============================================================================
# Auth
# =============================================================================
TWIN_AUTH_ADMIN_PROCESSOR_TYPE="entity-storage"
TWIN_AUTH_PROCESSOR_TYPE="entity-storage"

# =============================================================================
# Attestation — minimal vertical to exercise partitioned entity storage
# =============================================================================
# Connector type registers the attestation routes. "nft" delegates to the
# configured NFT connector (entity-storage above), so attestation records
# inherit [Node, Tenant] partitioning automatically.
TWIN_ATTESTATION_CONNECTOR="nft"
# Default verification method id is "attestation-assertion" — leave unset
# unless the node DID exposes a different method.

# =============================================================================
# Background Tasks
# =============================================================================
TWIN_BACKGROUND_TASKS_ENABLED="true"
TWIN_TASK_SCHEDULER_ENABLED="true"

# =============================================================================
# Trust — auto-enabled by node-core's configureTrust because rights-management
# is enabled below (see TICKET-A, Q13). Generators/verifiers/etc still need to
# be configured explicitly. Same generator/verifier as mobius.
# =============================================================================
TWIN_TRUST_GENERATORS="jwt-verifiable-credential"
TWIN_TRUST_VERIFIERS="jwt-verifiable-credential"
TWIN_TRUST_VERIFICATION_METHOD_ID="trust-assertion"
TWIN_TRUST_JWT_TTL_SECONDS="3600"

# =============================================================================
# Rights Management — PAP/PNP/PEP wired to verify per-tenant policy isolation.
# Engine partitions OdrlPolicy by [Node, Tenant] (see
# engine-types/src/components/rightsManagementPap.ts), so policies created by
# Tenant A must be invisible to Tenant B even when both share the same node.
# Negotiator/requester/enforcer/arbiter values mirror mobiusSupplyChainDocker
# (the known-good DSP scaffold) — required defaults for the engine to start
# rights-management cleanly even though we only exercise PAP CRUD.
# =============================================================================
TWIN_RIGHTS_MANAGEMENT_ENABLED="true"
TWIN_RIGHTS_MANAGEMENT_CALLBACK_PATH="rights-management"
TWIN_RIGHTS_MANAGEMENT_POLICY_NEGOTIATORS="pass-through"
TWIN_RIGHTS_MANAGEMENT_POLICY_REQUESTERS="pass-through"
TWIN_RIGHTS_MANAGEMENT_POLICY_ENFORCEMENT_PROCESSORS="default"
TWIN_RIGHTS_MANAGEMENT_POLICY_ARBITERS="default"
TWIN_RIGHTS_MANAGEMENT_POLICY_OBLIGATION_ENFORCERS="pass-through"

# =============================================================================
# Bootstrap
# =============================================================================
TWIN_FEATURES="node-identity,node-wallet,node-admin-user"
