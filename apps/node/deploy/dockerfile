# Build node-core from the repository source so the image matches the commit being built
FROM node:24 AS node-core

# Install pnpm, matching the version used by the repository
RUN npm install -g pnpm@12.4.1

WORKDIR /repo

# Install only node-core and its dependencies, using the repository lockfile
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/node-core/package.json packages/node-core/
COPY apps/node/package.json apps/node/
RUN pnpm install --frozen-lockfile --ignore-scripts --filter @twin.org/node-core

# Compile node-core and pack it as it would be published
COPY packages/node-core packages/node-core
WORKDIR /repo/packages/node-core
RUN pnpm run build \
	&& npm pkg delete scripts devDependencies \
	&& mkdir -p /pack \
	&& npm pack --pack-destination /pack \
	&& mv /pack/*.tgz /pack/node-core.tgz

# Set the base image
FROM node:24

# Install pnpm, matching the version used by the repository
RUN npm install -g pnpm@12.4.1

# Create the app directory
WORKDIR /app

# The repository pnpm-workspace.yaml is outside the app directory, so recreate the
# settings the install relies on, the @twin.org next builds are exempt from the release age hold.
# Use a flat node_modules, as code run in worker threads imports transitive dependencies by name
RUN printf "nodeLinker: hoisted\nminimumReleaseAgeExclude:\n  - '@twin.org/*'\n" > pnpm-workspace.yaml

# Copy the package.json and point node-core at the locally built package
COPY apps/node/package.json .
COPY --from=node-core /pack/node-core.tgz ./deploy/node-core.tgz
RUN npm pkg set "dependencies[@twin.org/node-core]=file:./deploy/node-core.tgz"

# Install dependencies including dev dependencies needed for merge-locales
RUN pnpm install --ignore-scripts --no-frozen-lockfile

# Copy the rest of the app files to the image
COPY apps/node .

# The app package.json was replaced by the copy, so point it at the local package again
RUN npm pkg set "dependencies[@twin.org/node-core]=file:./deploy/node-core.tgz"

# Compile translation messages
RUN pnpm run merge-locales

# Remove dev dependencies to reduce image size
RUN pnpm prune --prod --ignore-scripts

# Expose the port the app runs on
EXPOSE 3000

# Set the environment variables that will override the .env file in the package
ENV TWIN_HOST=0.0.0.0
ENV TWIN_PORT=3000
ENV TWIN_STORAGE_FILE_ROOT=/twin-node/data

# Start the server
CMD ["node", "src/index.js"]
