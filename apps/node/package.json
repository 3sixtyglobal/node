{
	"name": "@twin.org/node",
	"version": "0.11.1-next.0",
	"description": "TWIN Node serving APIs using the specified configuration",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iotaledger/twin-node.git",
		"directory": "apps/node"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage",
		"build": "echo There is no build step for this package",
		"dev": "concurrently \"nodemon\"",
		"merge-locales": "merge-locales",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"test:build": "tspc -p ./tests/tsconfig.json --noEmit",
		"validate-locales": "validate-locales",
		"docs:clean": "rimraf docs/open-api",
		"docs:api": "ts-to-openapi ./ts-to-openapi.json ./docs/open-api/spec.json",
		"docs": "pnpm run docs:clean && pnpm run docs:api",
		"dist": "pnpm run clean && concurrently -g -n build,merge,locales,types,test \"pnpm run build\" \"pnpm run merge-locales\" \"pnpm run validate-locales\" \"pnpm run test:build\" \"pnpm run test\"",
		"dist:no-test": "pnpm run clean && concurrently -g -n build,merge,locales,types \"pnpm run build\" \"pnpm run merge-locales\" \"pnpm run validate-locales\" \"pnpm run test:build\"",
		"test:n2n": "vitest --run --config ./vitest.config.ts tests/node-to-node/n2n-synced-storage.spec.ts",
		"test:soak": "node ./soak/run-soak.mjs",
		"start": "node src/index.js"
	},
	"dependencies": {
		"@twin.org/node-core": "0.11.1-next.0"
	},
	"devDependencies": {
		"@twin.org/entity-storage-connector-memory": "next",
		"@twin.org/merge-locales": "next",
		"@twin.org/nameof-transformer": "next",
		"@twin.org/nameof-vitest-plugin": "next",
		"@twin.org/ts-to-openapi": "next",
		"@twin.org/validate-locales": "next",
		"@types/node": "26.6.2",
		"@vitest/coverage-v8": "5.0.1",
		"concurrently": "10.0.5",
		"copyfiles": "2.4.1",
		"nodemon": "3.1.14",
		"rimraf": "6.1.3",
		"ts-patch": "4.0.1",
		"typedoc": "0.28.20",
		"typedoc-plugin-markdown": "4.13.1",
		"typescript": "6.0.3",
		"vitest": "5.0.1"
	},
	"bugs": {
		"url": "git+https://github.com/iotaledger/twin-node/issues"
	},
	"homepage": "https://twindev.org",
	"main": "./src/index.js",
	"exports": {
		".": {
			"import": "./src/index.js",
			"default": "./src/index.js"
		}
	},
	"files": [
		"bin",
		"dist/locales",
		"src/index.js",
		"locales",
		"docs"
	],
	"bin": {
		"twin-node": "bin/index.js"
	}
}
