{
	"name": "@twin.org/node",
	"version": "0.0.3-next.41",
	"description": "TWIN Node serving APIs using the specified configuration",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iotaledger/node.git",
		"directory": "apps/node"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage",
		"build": "echo There is no build step for this package",
		"dev": "concurrently \"nodemon\"",
		"merge-locales": "merge-locales",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:build": "tspc -p ./tests/tsconfig.json --noEmit",
		"test:n2n": "vitest --run --config ./vitest.config.ts tests/node-to-node/n2n-synced-storage.spec.ts",
		"validate-locales": "validate-locales",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"docs:clean": "rimraf docs/open-api",
		"docs:api": "ts-to-openapi ./ts-to-openapi.json ./docs/open-api/spec.json",
		"docs": "npm run docs:clean && npm run docs:api",
		"dist": "npm run clean && npm run build && npm run merge-locales && npm run validate-locales && npm run test:build && npm run test",
		"dist:no-test": "npm run clean && npm run build && npm run merge-locales",
		"start": "node src/index.js"
	},
	"dependencies": {
		"@twin.org/node-core": "0.0.3-next.41"
	},
	"devDependencies": {
		"@twin.org/entity-storage-connector-memory": "next",
		"@twin.org/merge-locales": "next",
		"@twin.org/nameof-transformer": "next",
		"@twin.org/nameof-vitest-plugin": "next",
		"@twin.org/ts-to-openapi": "next",
		"@twin.org/validate-locales": "next",
		"@types/node": "25.9.1",
		"@vitest/coverage-v8": "4.1.7",
		"concurrently": "9.2.1",
		"copyfiles": "2.4.1",
		"cross-env": "10.1.0",
		"nodemon": "3.1.14",
		"rimraf": "6.1.3",
		"ts-patch": "4.0.1",
		"typedoc": "0.28.19",
		"typedoc-plugin-markdown": "4.11.0",
		"typescript": "6.0.3",
		"vitest": "4.1.7"
	},
	"bugs": {
		"url": "git+https://github.com/iotaledger/node/issues"
	},
	"homepage": "https://twindev.org",
	"main": "./src/index.js",
	"exports": {
		".": {
			"import": "./src/index.js",
			"default": "./src/index.js"
		}
	},
	"files": [
		"bin",
		"dist/locales",
		"src/index.js",
		"locales",
		"docs"
	],
	"bin": {
		"twin-node": "bin/index.js"
	}
}
