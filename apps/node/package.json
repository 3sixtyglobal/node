{
	"name": "@3sixty/node",
	"version": "0.20.0-next.4",
	"description": "3Sixty Node serving APIs using the specified configuration",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/3sixtyglobal/node.git",
		"directory": "apps/node"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=24.0.0",
		"bun": ">=1.4.4"
	},
	"scripts": {
		"clean": "rimraf dist coverage .cache",
		"build": "echo There is no build step for this package",
		"dev": "concurrently \"nodemon\"",
		"merge-locales": "merge-locales",
		"test": "vitest --run --config ./vitest.config.ts",
		"test:bun": "bunx --bun vitest --run --config ./vitest.config.ts",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts",
		"test:build": "tstransform -p ./tests/tsconfig.json",
		"validate-locales": "validate-locales",
		"docs:clean": "rimraf docs/open-api",
		"docs:api": "ts-to-openapi ./ts-to-openapi.json ./docs/open-api/spec.json",
		"docs": "pnpm run docs:clean && pnpm run docs:api",
		"dist": "pnpm run clean && pnpm run merge-locales && concurrently -g -n build,locales,types,test \"pnpm run build\" \"pnpm run validate-locales\" \"pnpm run test:build\" \"pnpm run test\"",
		"dist:no-test": "pnpm run clean && pnpm run merge-locales && concurrently -g -n build,locales,types \"pnpm run build\" \"pnpm run validate-locales\" \"pnpm run test:build\"",
		"test:n2n": "vitest --run --config ./vitest.config.ts tests/node-to-node/n2n-synced-storage.spec.ts",
		"test:soak": "node ./soak/run-soak.mjs",
		"start": "node src/index.js"
	},
	"dependencies": {
		"@3sixty/node-core": "0.20.0-next.4"
	},
	"devDependencies": {
		"@3sixty/merge-locales": "next",
		"@3sixty/nameof-transformer": "next",
		"@3sixty/nameof-vitest-plugin": "next",
		"@3sixty/ts-to-openapi": "next",
		"@3sixty/validate-locales": "next",
		"@types/node": "26.6.5",
		"@vitest/coverage-v8": "5.0.5",
		"concurrently": "10.0.6",
		"nodemon": "3.1.14",
		"rimraf": "6.1.3",
		"typescript": "6.0.3",
		"vitest": "5.0.5"
	},
	"bugs": {
		"url": "git+https://github.com/3sixtyglobal/node/issues"
	},
	"homepage": "https://3sixty.global",
	"main": "./src/index.js",
	"exports": {
		".": {
			"import": "./src/index.js",
			"default": "./src/index.js"
		}
	},
	"files": [
		"bin",
		"dist/locales",
		"src/index.js",
		"locales",
		"docs"
	],
	"bin": {
		"3sixty-node": "bin/index.js"
	}
}
