#----------------------------- Connector Types -----------------------------#

# Entity Storage

## Entity Storage can be a comma separated list [file, memory, aws-dynamodb, azure-cosmosdb, gcp-firestoredb, scylladb, postgresql, mysql, mongodb]
TWIN_ENTITY_STORAGE_CONNECTOR_TYPE="file"

## Entity Storage Connector default connector, defaults to the first connector in the list
# TWIN_ENTITY_STORAGE_CONNECTOR_DEFAULT=""

## Prefix to add to tables in entity storage to separate the data from instances e.g. my-node-
# TWIN_ENTITY_STORAGE_TABLE_PREFIX=""

# Blob Storage

## Blob Storage can be a comma separated list [memory, file, ipfs, aws-s3, azure-storage, gcp-storage]
TWIN_BLOB_STORAGE_CONNECTOR_TYPE="file"

## Blob Storage Connector default connector, defaults to the first connector in the list
# TWIN_BLOB_STORAGE_CONNECTOR_DEFAULT=""

## Prefix to add to directories in blob storage
# TWIN_BLOB_STORAGE_PREFIX=""

## Enable encryption for blob storage, this will encrypt the data before storing it
TWIN_BLOB_STORAGE_ENABLE_ENCRYPTION=true

## The key id to use in the vault for encryption
# TWIN_BLOB_STORAGE_ENCRYPTION_KEY_ID="blob-encryption"

# Logging Connector

## Logging Connector [console,entity-storage]
## You can log to more than one connector my separating them with a comma
TWIN_LOGGING_CONNECTOR="console,entity-storage"

## A list of components to exclude from logging, can be a comma separated list of component Class names e.g. "ComponentA,ComponentB".
# TWIN_LOGGING_SILENT_COMPONENTS=""

## Batch Size for logging, set to 1 for no batching.
# TWIN_LOGGING_BATCH_SIZE="10"

## Batch Size flush interval in seconds, how often to flush the logs when using batching, defaults to 5 seconds.
# TWIN_LOGGING_BATCH_FLUSH_INTERVAL_SECONDS="5"

# Vault Connector

## Vault Connector [entity-storage, hashicorp]
TWIN_VAULT_CONNECTOR="entity-storage"

## Prefix to prepend to entries in the vault.
# TWIN_VAULT_PREFIX=""

# Event Bus Connector

## Event Bus Connector [local]
TWIN_EVENT_BUS_CONNECTOR="local"

## Event Bus Component [service]
# TWIN_EVENT_BUS_COMPONENT="service"

# Telemetry Connector

## Telemetry Connector [entity-storage, open-telemetry]
TWIN_TELEMETRY_CONNECTOR="entity-storage"

# How often to collect metrics, in seconds.
# TWIN_TELEMETRY_METRICS_COLLECTOR_INTERVAL_SECONDS="60"

# How many values to retain for each metric, count-based. Defaults to 1440 (e.g. 24 hours of data at 1-minute intervals).
# TWIN_TELEMETRY_METRICS_PRODUCER_MAX_HISTORY="1440"

# Comma separated list of telemetry metrics producers to enable. Defaults to system,process.
# TWIN_TELEMETRY_METRICS_PRODUCERS="system,process"

# OpenTelemetry runtime settings, used when TWIN_TELEMETRY_CONNECTOR="open-telemetry".
# TWIN_OPEN_TELEMETRY_METER_NAME="twin-node"
# TWIN_OPEN_TELEMETRY_METER_VERSION="1.0.0"
# TWIN_OPEN_TELEMETRY_READER="prometheus"
# TWIN_OPEN_TELEMETRY_PROMETHEUS_PORT="9464"

# Faucet Connector

## Faucet Connector Connector [entity-storage, iota]
TWIN_FAUCET_CONNECTOR="iota"

# Wallet Connector

## Wallet Connector Connector [entity-storage, iota]
TWIN_WALLET_CONNECTOR="iota"

# NFT Connector

## NFT Connector [entity-storage, iota]
TWIN_NFT_CONNECTOR="iota"

## The deployed package ID for the NFT smart contract.
# TWIN_NFT_PACKAGE_ID=""

# Notarization Connector

## Notarization Connector [entity-storage, iota]
TWIN_NOTARIZATION_CONNECTOR="iota"

# Identity Resolver Connector

## Identity Resolver Connector [entity-storage, iota, universal]
TWIN_IDENTITY_RESOLVER_CONNECTOR="iota"

## Endpoint for universal resolver
# TWIN_UNIVERSAL_RESOLVER_ENDPOINT=""

# Identity Connector

## Identity Connector [entity-storage, iota]
TWIN_IDENTITY_CONNECTOR="iota"

## The index of the wallet address to use, defaults to 0.
# TWIN_IDENTITY_WALLET_ADDRESS_INDEX="0"

# Identity Profile Connector

## Identity Profile Connector [entity-storage]
TWIN_IDENTITY_PROFILE_CONNECTOR="entity-storage"

# Immutable Proof

## The assertion method from the identity to use in immutable proof operations
# TWIN_IMMUTABLE_PROOF_VERIFICATION_METHOD_ID="immutable-proof-assertion"

# Attestation

## Attestation Connector Connector [nft]
TWIN_ATTESTATION_CONNECTOR="nft"

## The attestation assertion method to use from the DID
# TWIN_ATTESTATION_VERIFICATION_METHOD_ID="attestation-assertion"

# Auth Processor

## Auth Admin Type [entity-storage]
TWIN_AUTH_ADMIN_PROCESSOR_TYPE="entity-storage"

## Auth Type [entity-storage]
TWIN_AUTH_PROCESSOR_TYPE="entity-storage"

## The key to use for signing in auth operations
# TWIN_AUTH_SIGNING_KEY_ID="auth-signing"

## The HTTP header name used to pass the API key on requests, defaults to x-api-key.
# TWIN_AUTH_API_KEY_HEADER="x-api-key"

# Messaging

## Enable messaging, defaults to false.
# TWIN_MESSAGING_ENABLED="false"

## Messaging Email Connector Connector [entity-storage, aws]
# TWIN_MESSAGING_EMAIL_CONNECTOR="entity-storage"

## Messaging SMS Connector Connector [entity-storage, aws]
# TWIN_MESSAGING_SMS_CONNECTOR="entity-storage"

## Messaging Push Notifications Connector Connector [entity-storage, aws]
# TWIN_MESSAGING_PUSH_NOTIFICATION_CONNECTOR="entity-storage"

## The AWS Application for push notifications - use the @json: prefix to specify the path to the JSON file.
# TWIN_AWS_MESSAGING_PUSH_NOTIFICATION_APPLICATIONS="@json:aws-ses-apps.json"

# Data Processing

## Data Processing enabled, defaults to false.
TWIN_DATA_PROCESSING_ENABLED="true"

## Data Converters [json,xml]
TWIN_DATA_CONVERTER_CONNECTORS="json,xml"

## Data Extractors [json-path]
TWIN_DATA_EXTRACTOR_CONNECTORS="json-path"

# Auditable Item Graph

## Is the auditable item graph enabled, defaults to false.
TWIN_AUDITABLE_ITEM_GRAPH_ENABLED="true"

# Auditable Item Stream

## Is the auditable item stream enabled, defaults to false.
TWIN_AUDITABLE_ITEM_STREAM_ENABLED="true"

# Document Management

## Is the document management enabled, defaults to false.
TWIN_DOCUMENT_MANAGEMENT_ENABLED="true"

# Trust

## The trust generators to enable, comma separated list of module types e.g. jwt-verifiable-credential
# TWIN_TRUST_GENERATORS="jwt-verifiable-credential"

## The trust verifiers to enable, comma separated list of module types e.g. jwt-verifiable-credential
# TWIN_TRUST_VERIFIERS="jwt-verifiable-credential"

## The verification method to use for trust identities, defaults to trust-assertion.
# TWIN_TRUST_VERIFICATION_METHOD_ID="trust-assertion"

## The time to live for trust JWTs generation in seconds, defaults to undefined for never expiring.
# TWIN_TRUST_JWT_TTL_SECONDS="3600"

## Allow list for trust identity verification, comma separated.
# TWIN_TRUST_IDENTITIES_ALLOW="did:iota:example1,did:iota:example2"

## Deny list for trust identity verification, comma separated.
# TWIN_TRUST_IDENTITIES_DENY="did:iota:blocked"

# Federated Catalog

## Enable the federated catalogue, defaults to false, automatically enabled if remote endpoint, filters or dataspace is enabled.
# TWIN_FEDERATED_CATALOGUE_ENABLED="false"

## Federated catalog filters, command separated list of filters to add.
# TWIN_FEDERATED_CATALOGUE_FILTERS="filter-by-metadata"

## Federated catalog remote endpoint, if set will use a REST client instead of local service.
# TWIN_FEDERATED_CATALOGUE_REMOTE_ENDPOINT="http://fedcat-node:3000"

## Rights Management

## Path under which the rights management service is mounted (single source of truth).
## Drives the server route mount, the PNP callback URL builder, and the rest-client pathPrefix.
# TWIN_RIGHTS_MANAGEMENT_CALLBACK_PATH="rights-management"

## What is the callback path for rights management negotiations e.g. /rights-management.

## Policy Information Sources - use command separated lists of module types e.g. static,identity,identity-profile
# TWIN_RIGHTS_MANAGEMENT_POLICY_INFORMATION_SOURCES="static,identity,identity-profile"

## Policy Negotiators - use command separated lists of module types e.g. pass-through
# TWIN_RIGHTS_MANAGEMENT_POLICY_NEGOTIATORS="pass-through"

## Policy Requesters - use command separated lists of module types e.g. pass-through
# TWIN_RIGHTS_MANAGEMENT_POLICY_REQUESTERS="pass-through"

## Policy Execution Actions - use command separated lists of module types e.g. logging
# TWIN_RIGHTS_MANAGEMENT_POLICY_EXECUTION_ACTIONS="logging"

## Policy Enforcement Processors - use command separated lists of module types e.g. pass-through, default
# TWIN_RIGHTS_MANAGEMENT_POLICY_ENFORCEMENT_PROCESSORS="default"

## Policy Arbiters - use command separated lists of module types e.g. pass-through, default
# TWIN_RIGHTS_MANAGEMENT_POLICY_ARBITERS="default"

## Policy Obligation Enforcers - use command separated lists of module types e.g. pass-through
# TWIN_RIGHTS_MANAGEMENT_POLICY_OBLIGATION_ENFORCERS="pass-through"

## Dataspace
# TWIN_DATASPACE_ENABLED="false"

## The length of time to retain the activity logs for in minutes, set to -1 to keep forever.
# TWIN_DATASPACE_RETAIN_ACTIVITY_LOGS_FOR="10"

## The interval for cleaning up the activity logs.
# TWIN_DATASPACE_ACTIVITY_LOGS_CLEAN_UP_INTERVAL="60"

## The data plane path for PULL transfers (path only, not full URL). Required for PULL mode.
# TWIN_DATASPACE_DATA_PLANE_PATH="dataspace/entities"

## REST and Socket Route Processors

## Include the full body in the route logging, defaults to false unless debug is true
# TWIN_ROUTE_LOGGING_INCLUDE_BODY="false"

## Include the full base64 content in the route logging, defaults to false
# TWIN_ROUTE_LOGGING_FULL_BASE64="false"

## List of properties to obfuscate in the route logging, comma separated, defaults to "password"
# TWIN_ROUTE_LOGGING_OBFUSCATE_PROPERTIES="password,token,onboardingToken"

## Automation

## The type of automation action to perform, e.g. fetch
# TWIN_AUTOMATION_ACTION_TYPES="fetch"

## Health
# TWIN_HEALTH_ENABLED="false"

## The number of seconds between performing health checks, defaults to 60 seconds.
# TWIN_HEALTH_INTERVAL_SECONDS=60

## The delay in seconds before startup health checks begin, defaults to 2 seconds.
# TWIN_HEALTH_STARTUP_INTERVAL_SECONDS=2

# Mutex Timeouts

## Default mutex timeout in milliseconds, used when no component-specific timeout is set.
# TWIN_MUTEX_TIMEOUT_MS_DEFAULT=""

## Mutex timeout in milliseconds for the auditable item graph component.
# TWIN_AUDITABLE_ITEM_GRAPH_MUTEX_TIMEOUT_MS=""

## Mutex timeout in milliseconds for the auditable item stream component.
# TWIN_AUDITABLE_ITEM_STREAM_MUTEX_TIMEOUT_MS=""

## Mutex timeout in milliseconds for the federated catalogue component.
# TWIN_FEDERATED_CATALOGUE_MUTEX_TIMEOUT_MS=""

## Mutex timeout in milliseconds for the document management component.
# TWIN_DOCUMENT_MANAGEMENT_MUTEX_TIMEOUT_MS=""

## Mutex timeout in milliseconds for the logging component.
# TWIN_LOGGING_MUTEX_TIMEOUT_MS=""

## Mutex timeout in milliseconds for the memory entity storage connector.
# TWIN_ENTITY_STORAGE_MEMORY_MUTEX_TIMEOUT_MS=""

## Mutex timeout in milliseconds for the file entity storage connector.
# TWIN_ENTITY_STORAGE_FILE_MUTEX_TIMEOUT_MS=""

## Mutex timeout in milliseconds for the rights management component.
# TWIN_RIGHTS_MANAGEMENT_MUTEX_TIMEOUT_MS=""

# Extensions

## Comma separated list of modules to load as extensions
# TWIN_EXTENSIONS=""

# REST Paths - Use the component name e.g. for logging or dataspaceControlPlane, dataspaceDataPlane
# TWIN_REST_PATH_LOGGING="/foo-logging"
# TWIN_REST_PATH_DATASPACE_CONTROL_PLANE="/foo-dataspace"
# TWIN_REST_PATH_DATASPACE_DATA_PLANE="/foo-dataspace"
