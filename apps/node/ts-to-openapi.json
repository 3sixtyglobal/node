	"servers": ["https://node-api.twindev.org"],
	"restRoutes": [
		{
			"package": "@3sixty/api-service"
		},
		{
			"package": "@3sixty/api-auth-entity-storage-service"
		},
		{
			"package": "@3sixty/identity-service"
		},
		{
			"package": "@3sixty/blob-storage-service"
		},
		{
			"package": "@3sixty/telemetry-service"
		},
		{
			"package": "@3sixty/automation-service"
		},
		{
			"package": "@3sixty/logging-service"
		},
		{
			"package": "@3sixty/nft-service"
		},
		{
			"package": "@3sixty/notarization-service"
		},
		{
			"package": "@3sixty/attestation-service"
		},
		{
			"package": "@3sixty/immutable-proof-service"
		},
		{
			"package": "@3sixty/data-processing-service"
		},
		{
			"package": "@3sixty/document-management-service"
		},
		{
			"package": "@3sixty/auditable-item-graph-service",
			"entryPoints": [
				{
					"name": "auditable-item-graph",
					"baseRoutePath": "aig"
				}
			]
		},
		{
			"package": "@3sixty/auditable-item-stream-service",
			"entryPoints": [
				{
					"name": "auditable-item-stream",
					"baseRoutePath": "ais"
				}
			]
		},
		{
			"package": "@3sixty/document-management-service"
		},
		{
			"package": "@3sixty/federated-catalogue-service"
		},
		{
			"package": "@3sixty/dataspace-data-plane-service"
		},
		{
			"package": "@3sixty/dataspace-data-plane-service"
		},
		{
			"package": "@3sixty/dataspace-control-plane-service"
		},
		{
			"package": "@3sixty/rights-management-service"
		}
	],
	"authMethods": ["jwtBearer"],
	"externalReferences": {
		"JsonLd(.*?)": "https://schema.3sixty.global/json-ld/JsonLd$1",
		"AuditableItemGraph(.*?)": "https://schema.3sixty.global/aig/AuditableItemGraph$1",
		"AuditableItemStream(.*?)": "https://schema.3sixty.global/ais/AuditableItemStream$1",
		"Attestation(.*?)": "https://schema.3sixty.global/attestation/Attestation$1",
		"BlobStorage(.*?)": "https://schema.3sixty.global/blob-storage/BlobStorage$1",
		"Did(.*?)": "https://schema.3sixty.global/w3c-did/Did$1",
		"ProofTypes": "https://schema.3sixty.global/w3c-did/ProofTypes",
		"Proof": "https://schema.3sixty.global/w3c-did/Proof",
		"DataIntegrityProof": "https://schema.3sixty.global/w3c-did/DataIntegrityProof",
		"JsonWebSignature2020Proof": "https://schema.3sixty.global/w3c-did/JsonWebSignature2020Proof",
		"Document(.*?)": "https://schema.3sixty.global/documents/Document$1",
		"ImmutableProof(.*)": "https://schema.3sixty.global/immutable-proof/ImmutableProof$1",
		"Odrl(.*)": "https://schema.3sixty.global/w3c-odrl/Odrl$1",
		"Unece(.*)": "https://schema.3sixty.global/unece/Unece$1",
		"DataspaceProtocol(.*?)": "https://schema.3sixty.global/dataspace-protocol/DataspaceProtocol$1",
		"Dcat(.*?)": "https://schema.3sixty.global/dcat/Dcat$1",
		"DublinCore(.*?)": "https://schema.3sixty.global/dublin-core/DublinCore$1",
		"Foaf(.*?)": "https://schema.3sixty.global/foaf/Foaf$1",
		"ActivityStreams(.*?)": "https://schema.3sixty.global/w3c-activity-streams/ActivityStreams$1"
	}
}
