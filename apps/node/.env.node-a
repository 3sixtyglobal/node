# =============================================================================
# Node A - N2N Synchronized Storage Demo Configuration
# =============================================================================
# Port: 3000 | Trusted node (writes sync pointers to IOTA verifiable storage)
# Use with: node --env-file=<path-to-this-file> src/index.js
# Run from: node/apps/node/
#
# Differences from node-a.env:
#   - Entity storage: file wrapped with synchronised connector
#   - Blob storage: IPFS for sync blobs + file for local
#   - Verifiable storage: iota (not entity-storage)
#   - Synchronized storage: enabled (this node is trusted)

# =============================================================================
# Web Server
# =============================================================================
TWIN_PORT=3000
TWIN_HOST="0.0.0.0"
TWIN_PUBLIC_ORIGIN="http://localhost:3000"
TWIN_DEBUG=true

# =============================================================================
# Node Identity
# If TWIN_NODE_MNEMONIC is not set, bootstrap-legacy generates a random
# 24-word BIP39 mnemonic automatically. Uncomment to use a fixed one.
# =============================================================================
# TWIN_NODE_MNEMONIC="your 24 word mnemonic here ..."

# =============================================================================
# Storage - SEPARATE PATH FOR NODE A
# Entity storage uses "synchronised" as default, wrapping "file" underneath.
# =============================================================================
TWIN_ENTITY_STORAGE_CONNECTOR_TYPE="file,synchronised"
TWIN_STORAGE_FILE_ROOT="../../.local-data/node-a/"

# =============================================================================
# Blob Storage - IPFS for sync blobs, file for local
# The "public" tag tells synchronised storage to use IPFS for blob transport.
# =============================================================================
TWIN_BLOB_STORAGE_CONNECTOR_TYPE="file,ipfs"
TWIN_BLOB_STORAGE_CONNECTOR_PUBLIC="ipfs"
TWIN_BLOB_STORAGE_ENABLE_ENCRYPTION=true
TWIN_IPFS_API_URL="http://localhost:5001/api/v0"

# =============================================================================
# Synchronized Storage - Node A is the TRUSTED node
# No TWIN_SYNCHRONISED_STORAGE_TRUSTED_URL means this node writes directly
# to verifiable storage and holds the encryption key.
# =============================================================================
TWIN_SYNCHRONISED_STORAGE_ENABLED="true"
TWIN_SYNCHRONISED_STORAGE_VERIFIABLE_STORAGE_KEY_ID="verifiable:iota:0x2dc63eedae3a93a908bc724c2b77a1f500c67eba131b8422ba3f06e6e99a10e0:0x07531abd9f1d61ed45a4042e1eaa79762644121f8f4c39b4186ab30910ab18ab"
TWIN_SYNCHRONISED_STORAGE_BLOB_STORAGE_ENCRYPTION_KEY_ID="synchronised-storage-blob-encryption-key"
# DEV-ONLY key for local testing. Both nodes must share the same key.
# Generate a new one with: openssl rand -base64 32
TWIN_SYNCHRONISED_STORAGE_BLOB_STORAGE_KEY="HpD0tijf/ZCTS87Qec8zsJQTykvWRPZolpDV5+YmV5g="
# Fast sync for testing (default is 5 minutes)
TWIN_SYNCHRONISED_STORAGE_ENTITY_UPDATE_INTERVAL_MINUTES="1"
TWIN_SYNCHRONISED_STORAGE_CONSOLIDATION_INTERVAL_MINUTES="5"

# =============================================================================
# Connectors - IOTA for cross-node DID resolution
# Verifiable storage must be "iota" for sync pointers on-chain.
# =============================================================================
TWIN_IDENTITY_CONNECTOR="iota"
TWIN_IDENTITY_RESOLVER_CONNECTOR="iota"
TWIN_IDENTITY_PROFILE_CONNECTOR="entity-storage"
TWIN_VAULT_CONNECTOR="entity-storage"
TWIN_LOGGING_CONNECTOR="console,entity-storage"
TWIN_WALLET_CONNECTOR="iota"
TWIN_FAUCET_CONNECTOR="iota"
TWIN_NFT_CONNECTOR="entity-storage"
TWIN_VERIFIABLE_STORAGE_CONNECTOR="iota"
TWIN_EVENT_BUS_CONNECTOR="local"
TWIN_TELEMETRY_CONNECTOR="entity-storage"

# =============================================================================
# IOTA Configuration - Same testnet for both nodes
# =============================================================================
TWIN_IOTA_NODE_ENDPOINT="https://api.testnet.iota.cafe"
TWIN_IOTA_FAUCET_ENDPOINT="https://faucet.testnet.iota.cafe/api/enqueue"
TWIN_IOTA_NETWORK="testnet"

# =============================================================================
# Auth Processor - Required for admin login
# =============================================================================
TWIN_AUTH_ADMIN_PROCESSOR_TYPE="entity-storage"
TWIN_AUTH_PROCESSOR_TYPE="entity-storage"

# =============================================================================
# Trust Service — auto-enabled by node-core when synchronised-storage is
# enabled (see TICKET-A, Q13). Required for N2N token validation.
# =============================================================================
TWIN_TRUST_GENERATORS="jwt-verifiable-credential"
TWIN_TRUST_VERIFIERS="jwt-verifiable-credential"
TWIN_TRUST_VERIFICATION_METHOD_ID="trust-assertion"
TWIN_TRUST_JWT_TTL_SECONDS="3600"

# =============================================================================
# Dataspace - Control Plane + Data Plane
# =============================================================================
TWIN_DATASPACE_ENABLED=true
TWIN_DATASPACE_DATA_PLANE_PATH="dataspace/entities"

# =============================================================================
# Extensions - Load the test app to serve demo data
# =============================================================================
TWIN_EXTENSIONS="@twin.org/dataspace-test-app"

# =============================================================================
# Federated Catalogue - For service discovery
# =============================================================================
TWIN_FEDERATED_CATALOGUE_ENABLED=true
TWIN_FEDERATED_CATALOGUE_DATASET_STORAGE_CONNECTOR_TYPE="synchronised"

# =============================================================================
# Rights Management - All pass-through for demo
# =============================================================================
TWIN_RIGHTS_MANAGEMENT_ENABLED=true
TWIN_RIGHTS_MANAGEMENT_CALLBACK_PATH="rights-management"
TWIN_RIGHTS_MANAGEMENT_POLICY_NEGOTIATORS="pass-through"
TWIN_RIGHTS_MANAGEMENT_POLICY_REQUESTERS="pass-through"
TWIN_RIGHTS_MANAGEMENT_POLICY_ENFORCEMENT_PROCESSORS="pass-through"
TWIN_RIGHTS_MANAGEMENT_POLICY_ARBITERS="pass-through"
TWIN_RIGHTS_MANAGEMENT_POLICY_OBLIGATION_ENFORCERS="pass-through"

# =============================================================================
# Background Tasks & Task Scheduler
# =============================================================================
TWIN_BACKGROUND_TASKS_ENABLED="true"
TWIN_TASK_SCHEDULER_ENABLED="true"

# =============================================================================
# Bootstrap Features
# =============================================================================
TWIN_FEATURES="node-identity,node-wallet,node-admin-user"
