# Immutable Proof

## The assertion method from the identity to use in immutable proof operations
# TWIN_IMMUTABLE_PROOF_VERIFICATION_METHOD_ID="immutable-proof-assertion"

## The number of retries for proof tasks before they are abandoned (default: 5)
# TWIN_IMMUTABLE_PROOF_TASK_RETRY_COUNT=5

## The interval in seconds between proof task retries (default: 5)
# TWIN_IMMUTABLE_PROOF_TASK_RETRY_INTERVAL=5

## The time in minutes to retain failed proof tasks, -1 to retain forever (default: 10080)
# TWIN_IMMUTABLE_PROOF_TASK_FAILURE_RETAIN_FOR=10080

## How often in minutes the immutable proof sweep runs (default: 30, minimum: 1)
# TWIN_IMMUTABLE_PROOF_SWEEP_INTERVAL=30

## Minimum age in minutes before a proof is considered stale for sweeping (default: 180, minimum: 1)
# TWIN_IMMUTABLE_PROOF_SWEEP_STALE_THRESHOLD=180

## Maximum sweep attempts before a proof is parked (default: 5, minimum: 1)
# TWIN_IMMUTABLE_PROOF_SWEEP_MAX_ATTEMPTS=5

## Maximum proofs re-enqueued per tenant on each sweep cycle (default: 10, minimum: 1)
# TWIN_IMMUTABLE_PROOF_SWEEP_BATCH_LIMIT=10

## Base delay in minutes between sweep attempts for the same proof (default: 60, minimum: 1)
# TWIN_IMMUTABLE_PROOF_SWEEP_BACKOFF=60

## ISO 8601 date-time; proofs created before this value may be treated as retryable when task state is missing
# TWIN_IMMUTABLE_PROOF_SWEEP_ASSUME_RETRYABLE_BEFORE="2026-01-01T00:00:00.000Z"

