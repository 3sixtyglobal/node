# Entity Storage

## Entity Storage can be a comma separated list [file, memory, aws-dynamodb, azure-cosmosdb, gcp-firestoredb, scylladb, postgresql, mysql, mongodb]
TWIN_ENTITY_STORAGE_CONNECTOR_TYPE="aws-dynamodb"

## Entity Storage Connector default connector, defaults to the first connector in the list
# TWIN_ENTITY_STORAGE_CONNECTOR_DEFAULT=""

## Prefix to add to tables in entity storage to separate the data from instances e.g. my-node-
TWIN_ENTITY_STORAGE_TABLE_PREFIX="twin-node-"

# Blob Storage

## Blob Storage can be a comma separated list [memory, file, ipfs, aws-s3, azure-storage, gcp-storage]
TWIN_BLOB_STORAGE_CONNECTOR_TYPE="ipfs"

## Blob Storage Connector default connector, defaults to the first connector in the list
# TWIN_BLOB_STORAGE_CONNECTOR_DEFAULT=""

## Prefix to add to directories in blob storage
# TWIN_BLOB_STORAGE_PREFIX=""

## Enable encryption for blob storage, this will encrypt the data before storing it
TWIN_BLOB_STORAGE_ENABLE_ENCRYPTION=true

## The key id to use in the vault for encryption
# TWIN_BLOB_STORAGE_ENCRYPTION_KEY_ID="blob-encryption"

# Logging Connector

## Logging Connector [console,entity-storage,open-telemetry,file]
## You can log to more than one connector by separating them with a comma
TWIN_LOGGING_CONNECTOR="console,entity-storage"

## A list of components to exclude from logging, can be a comma separated list of component Class names e.g. "ComponentA,ComponentB".
# TWIN_LOGGING_SILENT_COMPONENTS=""

## Batch Size for logging, set to 1 for no batching.
# TWIN_LOGGING_BATCH_SIZE="10"

## Batch Size flush interval in seconds, how often to flush the logs when using batching, defaults to 5 seconds.
# TWIN_LOGGING_BATCH_FLUSH_INTERVAL="5"

## Delete log entries older than this many minutes (entity-storage logging), defaults to 2880 (2 days). Set to 0 to disable age-based retention.
# TWIN_LOGGING_RETAIN_FOR="2880"

## Keep at most this many log entries (entity-storage logging), defaults to 10000. Set to 0 to disable count-based retention.
# TWIN_LOGGING_MAX_ENTRIES="10000"

## How often retention cleanup runs in minutes (entity-storage logging), defaults to 5. Set to 0 to disable periodic cleanup.
# TWIN_LOGGING_RETENTION_INTERVAL="5"

## Maximum entries deleted per retention cleanup batch (entity-storage logging), defaults to 1000.
# TWIN_LOGGING_RETENTION_BATCH_SIZE="1000"

## File logging connector settings (only used when TWIN_LOGGING_CONNECTOR includes "file")
## Directory to write log files into. Required when using the file logging connector.
# TWIN_LOGGING_FILE_DIRECTORY="./logs"

## Log filename, defaults to "app.log".
# TWIN_LOGGING_FILE_FILENAME="app.log"

## Maximum log file size in bytes before rotation, defaults to 10485760 (10 MB). Set to 0 to disable rotation.
# TWIN_LOGGING_FILE_MAX_FILE_SIZE_BYTES="10485760"

## Number of rotated log files to retain, defaults to 5. Set to 0 to keep all rotated files.
# TWIN_LOGGING_FILE_MAX_RETAINED_FILES="5"

