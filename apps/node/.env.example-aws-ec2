## Rights Management

## Path under which the rights management service is mounted (single source of truth).
## Drives the server route mount, the PNP callback URL builder, and the rest-client pathPrefix.
# TWIN_RIGHTS_MANAGEMENT_CALLBACK_PATH="rights-management"

## What is the callback path for rights management negotiations e.g. /rights-management.

## Policy Information Sources - use command separated lists of module types e.g. static,identity,identity-profile
# TWIN_RIGHTS_MANAGEMENT_POLICY_INFORMATION_SOURCES="static,identity,identity-profile"

## Policy Negotiators - use command separated lists of module types e.g. pass-through
# TWIN_RIGHTS_MANAGEMENT_POLICY_NEGOTIATORS="pass-through"

## Policy Requesters - use command separated lists of module types e.g. pass-through
# TWIN_RIGHTS_MANAGEMENT_POLICY_REQUESTERS="pass-through"

## Policy Execution Actions - use command separated lists of module types e.g. logging
# TWIN_RIGHTS_MANAGEMENT_POLICY_EXECUTION_ACTIONS="logging"

## Policy Enforcement Processors - use command separated lists of module types e.g. pass-through, default
# TWIN_RIGHTS_MANAGEMENT_POLICY_ENFORCEMENT_PROCESSORS="default"

## Policy Arbiters - use command separated lists of module types e.g. pass-through, default
# TWIN_RIGHTS_MANAGEMENT_POLICY_ARBITERS="default"

## Policy Obligation Enforcers - use command separated lists of module types e.g. pass-through
# TWIN_RIGHTS_MANAGEMENT_POLICY_OBLIGATION_ENFORCERS="pass-through"

## Dataspace
# TWIN_DATASPACE_ENABLED="false"

## The length of time to retain the activity logs for in seconds, set to -1 to keep forever.
# TWIN_DATASPACE_RETAIN_ACTIVITY_LOGS_FOR="600"

## The interval in seconds for cleaning up the activity logs.
# TWIN_DATASPACE_ACTIVITY_LOGS_CLEANUP_INTERVAL="3600"

## Base route path for the data plane service (path only, not full URL).
## Combined with the public origin to form the data-address endpoint for PULL consumers and the inbox URL for PUSH providers.
## This must be the mount-point prefix — do NOT append sub-paths such as /entities or /inbox.
## Required for PULL or PUSH transfers.
# TWIN_DATASPACE_DATA_PLANE_PATH="dataspace"

## Whether the provider immediately starts a transfer once it has been requested. Defaults to false.
# TWIN_DATASPACE_AUTO_START_TRANSFERS="false"

## TTL in milliseconds for caching dataspace agreements in the control plane service.
# TWIN_DATASPACE_AGREEMENT_CACHE_TTL=""

## Mutex timeout in milliseconds for the dataspace agreement cache.
# TWIN_DATASPACE_AGREEMENT_CACHE_MUTEX_TIMEOUT=""

## Time in milliseconds after which an unused agreement is eligible for removal.
# TWIN_DATASPACE_AGREEMENT_UNUSED_THRESHOLD=""

## Interval in milliseconds between agreement sweep runs.
# TWIN_DATASPACE_AGREEMENT_SWEEP_INTERVAL=""

## The number of times to retry failed data plane tasks.
# TWIN_DATASPACE_RETRY_COUNT=""

## Maximum HTTP retry attempts per push delivery task execution.
# TWIN_DATASPACE_PUSH_RETRY_COUNT=""

## Base delay in milliseconds for exponential backoff between push HTTP retries.
# TWIN_DATASPACE_PUSH_RETRY_BASE_DELAY=""

## Timeout in milliseconds for each push delivery HTTP POST request.
# TWIN_DATASPACE_PUSH_TIMEOUT=""

## Interval in milliseconds between orphaned push subscription cleanup scans.
# TWIN_DATASPACE_PUSH_SUBSCRIPTION_CLEANUP_INTERVAL=""

## How long in seconds a negotiation may sit without progress before it times out.
# TWIN_DATASPACE_STALLED_NEGOTIATION_TIMEOUT="30"

## How long in seconds a consumer transfer may sit in REQUESTED before it times out.
# TWIN_DATASPACE_STALLED_TRANSFER_TIMEOUT="30"

## How long in seconds a provider transfer may remain idle before the idle policy marks it as stalled.
# TWIN_DATASPACE_PROVIDER_TRANSFER_IDLE_TIMEOUT="30"

## How often in seconds the provider idle transfer policy sweep runs.
# TWIN_DATASPACE_PROVIDER_TRANSFER_POLICY_SWEEP_INTERVAL="10"

## Path under which the dataspace control plane is mounted, combined with public origin to build callback address.
# TWIN_DATASPACE_CALLBACK_PATH="dataspace-control-plane"

