# Soak profile: file-local (default)
# Self-contained, file-backed node for soak/load testing. All names are validated
# against the node's strict env-var validation (#243) — keep them exact.
#
# TWIN_PORT and TWIN_STORAGE_FILE_ROOT are set by the orchestrator at runtime and
# override anything here.

# --- storage (file-backed, production-representative persistence) ---
TWIN_ENTITY_STORAGE_CONNECTOR_TYPE=file
TWIN_BLOB_STORAGE_CONNECTOR_TYPE=file

# --- core connectors ---
TWIN_VAULT_CONNECTOR=entity-storage
TWIN_IDENTITY_CONNECTOR=entity-storage
TWIN_IDENTITY_RESOLVER_CONNECTOR=entity-storage
TWIN_IDENTITY_PROFILE_CONNECTOR=entity-storage
TWIN_LOGGING_CONNECTOR=entity-storage
TWIN_EVENT_BUS_CONNECTOR=local
TWIN_EVENT_BUS_COMPONENT=service

# --- auth ---
TWIN_AUTH_ADMIN_PROCESSOR_TYPE=entity-storage
TWIN_AUTH_PROCESSOR_TYPE=entity-storage

# --- health (enables the /health endpoint; the harness readiness probe uses /readyz) ---
TWIN_HEALTH_ENABLED=true
TWIN_HEALTH_STARTUP_INTERVAL=30

# --- telemetry (kept on for a realistic node; the soak sampler reads OS-level memory via PID, not this) ---
TWIN_TELEMETRY_CONNECTOR=entity-storage
TWIN_TELEMETRY_METRICS_PRODUCERS=system,process
TWIN_TELEMETRY_METRICS_COLLECTOR_INTERVAL=15

# --- optional API areas (phase 5 multi-endpoint scenario) ---
TWIN_AUDITABLE_ITEM_GRAPH_ENABLED=true
TWIN_AUDITABLE_ITEM_STREAM_ENABLED=true
# TWIN_DOCUMENT_MANAGEMENT_ENABLED=true  # stretch: enable once the docman group lands (requires AIG above)

# --- phase 2 API areas (feat-249 broaden coverage round 2) ---
TWIN_NOTARIZATION_CONNECTOR=entity-storage
TWIN_FEDERATED_CATALOGUE_ENABLED=true
TWIN_DATASPACE_ENABLED=true

# --- rights management (required by dataspace control plane) ---
TWIN_RIGHTS_MANAGEMENT_CALLBACK_PATH=/rights-management
TWIN_RIGHTS_MANAGEMENT_POLICY_INFORMATION_SOURCES=static
TWIN_RIGHTS_MANAGEMENT_POLICY_NEGOTIATORS=pass-through
TWIN_RIGHTS_MANAGEMENT_POLICY_REQUESTERS=pass-through
TWIN_RIGHTS_MANAGEMENT_POLICY_EXECUTION_ACTIONS=logging
TWIN_RIGHTS_MANAGEMENT_POLICY_ENFORCEMENT_PROCESSORS=pass-through
TWIN_RIGHTS_MANAGEMENT_POLICY_ARBITERS=pass-through
TWIN_DATASPACE_DATA_PLANE_PATH=dataspace

# --- trust (registers JWT VC verifier + generator; required for fedcat/dataspace trust checks) ---
TWIN_TRUST_GENERATORS=jwt-verifiable-credential
TWIN_TRUST_VERIFIERS=jwt-verifiable-credential
TWIN_TRUST_VERIFICATION_METHOD_ID=trust-assertion
TWIN_TRUST_JWT_TTL=3600

# --- soak thresholds (calibrated from 15-min smoke run 2026-06-26; file I/O is slower than MySQL) ---
# Observed p95≈2440ms / p99≈3940ms across two clean runs; ~25% headroom each.
SOAK_P95_MS=3000
SOAK_P99_MS=5000

# --- k6 dashboard ---
K6_WEB_DASHBOARD=true
K6_WEB_DASHBOARD_EXPORT=.out/k6-dashboard.html

# --- noise control ---
TWIN_SILENT=false
