{
	"$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
	"description": "Auto-Generated Release Please configuration for prod",
	"pull-request-title-pattern": "chore: prod release prepared",
	"group-pull-request-title-pattern": "chore: release ${branch}",
	"pull-request-header": "chore: prod release prepared",
	"pull-request-footer": "This PR was generated by the Release Production GHA",
	"release-type": "node",
	"initial-version": "0.0.1",
	"versioning": "default",
	"last-release-sha": "997069cf1fb192b371b3f24183347e676348ef1b",
	"packages": {
		"packages/node-core": {
			"package-name": "node-core",
			"changelog-path": "docs/changelog.md",
			"extra-files": [
				"src/node.ts"
			]
		},
		"apps/node": {
			"package-name": "node",
			"changelog-path": "docs/changelog.md"
		}
	},
	"plugins": [
		"node-workspace",
		{
			"type": "linked-versions",
			"groupName": "repo",
			"components": [
				"node-core",
				"node"
			]
		}
	]
}
