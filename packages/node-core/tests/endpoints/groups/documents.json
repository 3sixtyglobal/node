{
	"group": "Document Management",
	"steps": [
		{
			"description": "POST /documents - 400 missing blob",
			"method": "POST",
			"path": "/documents",
			"body": {
				"document": {
					"documentId": "{{docId}}",
					"documentIdFormat": "PLAIN",
					"documentCode": "unece:DocumentCodeList#1"
				}
			},
			"expectedStatus": 400
		},
		{
			"description": "POST /documents - 400 missing documentId",
			"method": "POST",
			"path": "/documents",
			"body": {
				"document": {
					"documentIdFormat": "PLAIN",
					"documentCode": "unece:DocumentCodeList#1"
				},
				"blob": "dGVzdCBkb2N1bWVudA=="
			},
			"expectedStatus": 400
		},
		{
			"description": "POST /documents",
			"method": "POST",
			"path": "/documents",
			"body": {
				"document": {
					"documentId": "{{docId}}",
					"documentIdFormat": "PLAIN",
					"documentCode": "unece:DocumentCodeList#1"
				},
				"blob": "dGVzdCBkb2N1bWVudA=="
			},
			"expectedStatus": 201,
			"capture": { "docGraphId": "location-last-segment" }
		},
		{
			"description": "GET /documents/:id - 404 for unknown id",
			"method": "GET",
			"path": "/documents/aig:nonexistent",
			"expectedStatus": 404
		},
		{
			"description": "GET /documents/:id - initial revision",
			"method": "GET",
			"path": "/documents/{{docGraphId}}",
			"expectedStatus": 200,
			"capture": { "documentRevision": "body.itemListElement.[0].documentRevision" },
			"assert": { "body.itemListElement.[0].documentRevision": 0 }
		},
		{
			"description": "GET /documents/:id/:revision - get revision 0",
			"method": "GET",
			"path": "/documents/{{docGraphId}}/{{documentRevision}}",
			"expectedStatus": 200
		},
		{
			"description": "PATCH /documents/:id - update blob",
			"method": "PATCH",
			"path": "/documents/{{docGraphId}}",
			"body": {
				"blob": "dXBkYXRlZCBkb2N1bWVudA=="
			},
			"expectedStatus": 204
		},
		{
			"description": "GET /documents/:id - revision 1 after blob update",
			"method": "GET",
			"path": "/documents/{{docGraphId}}",
			"expectedStatus": 200,
			"capture": { "documentRevision1": "body.itemListElement.[0].documentRevision" },
			"assert": { "body.itemListElement.[0].documentRevision": 1 }
		},
		{
			"description": "GET /documents/:id/:revision - get revision 1",
			"method": "GET",
			"path": "/documents/{{docGraphId}}/{{documentRevision1}}",
			"expectedStatus": 200
		},
		{
			"description": "GET /documents/:id?limit=2 - both revisions in history",
			"method": "GET",
			"path": "/documents/{{docGraphId}}?limit=2",
			"expectedStatus": 200
		},
		{
			"description": "PATCH /documents/:id - update blob and documentCode",
			"method": "PATCH",
			"path": "/documents/{{docGraphId}}",
			"body": {
				"document": {
					"documentCode": "unece:DocumentCodeList#705"
				},
				"blob": "dXBkYXRlZCBkb2N1bWVudCB2Mg=="
			},
			"expectedStatus": 204
		},
		{
			"description": "GET /documents/:id - revision 2 after metadata update",
			"method": "GET",
			"path": "/documents/{{docGraphId}}",
			"expectedStatus": 200,
			"capture": { "documentRevision2": "body.itemListElement.[0].documentRevision" },
			"assert": { "body.itemListElement.[0].documentRevision": 2 }
		},
		{
			"description": "GET /documents/:id/:revision - get revision 2",
			"method": "GET",
			"path": "/documents/{{docGraphId}}/{{documentRevision2}}",
			"expectedStatus": 200
		},
		{
			"description": "GET /documents - list by documentId",
			"method": "GET",
			"path": "/documents?documentId={{docId}}",
			"expectedStatus": 200
		},
		{
			"description": "DELETE /documents/:id/:revision - delete initial revision",
			"method": "DELETE",
			"path": "/documents/{{docGraphId}}/{{documentRevision}}",
			"expectedStatus": 204
		},
		{
			"description": "GET /documents/:id/:revision - dateDeleted set after delete",
			"method": "GET",
			"path": "/documents/{{docGraphId}}/{{documentRevision}}",
			"expectedStatus": 200,
			"assert": { "body.dateDeleted": "isDefined" }
		}
	]
}
