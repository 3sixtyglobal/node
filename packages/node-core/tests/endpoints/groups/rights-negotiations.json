{
	"group": "Rights Management - Negotiations",
	"steps": [
		{
			"description": "POST /rights-management/negotiations/request — 401 without organization context",
			"skipIfOrgParamOmitted": true,
			"appendOrgParam": false,
			"method": "POST",
			"path": "/rights-management/negotiations/request",
			"headers": {
				"authorization": "{{trustAuthorization}}",
				"accept": "application/ld+json"
			},
			"body": {
				"@context": ["https://w3id.org/dspace/2025/1/context.jsonld"],
				"@type": "ContractRequestMessage",
				"consumerPid": "urn:uuid:11111111-1111-1111-1111-111111111111",
				"callbackAddress": "https://example.com/callback",
				"offer": {
					"@type": "Offer",
					"@id": "{{offerPolicyId}}"
				}
			},
			"expectedStatus": 401
		},
		{
			"description": "POST /rights-management/negotiations/request — 400 missing consumerPid",
			"appendOrgParam": true,
			"method": "POST",
			"path": "/rights-management/negotiations/request",
			"headers": {
				"authorization": "{{trustAuthorization}}",
				"accept": "application/ld+json"
			},
			"body": {
				"@context": ["https://w3id.org/dspace/2025/1/context.jsonld"],
				"@type": "ContractRequestMessage",
				"callbackAddress": "https://example.com/callback",
				"offer": {
					"@type": "Offer",
					"@id": "{{offerPolicyId}}"
				}
			},
			"expectedStatus": 400
		},
		{
			"description": "POST /rights-management/negotiations/request — initiate negotiation",
			"appendOrgParam": true,
			"method": "POST",
			"path": "/rights-management/negotiations/request",
			"headers": {
				"authorization": "{{trustAuthorization}}",
				"accept": "application/ld+json"
			},
			"body": {
				"@context": ["https://w3id.org/dspace/2025/1/context.jsonld"],
				"@type": "ContractRequestMessage",
				"consumerPid": "urn:uuid:11111111-1111-1111-1111-111111111111",
				"callbackAddress": "http://127.0.0.1:19999/callback",
				"offer": {
					"@type": "Offer",
					"@id": "{{offerPolicyId}}"
				}
			},
			"expectedStatus": 201,
			"capture": { "negotiationProviderPid": "body.providerPid" }
		},
		{
			"description": "GET /rights-management/negotiations/:id",
			"appendOrgParam": true,
			"method": "GET",
			"path": "/rights-management/negotiations/{{negotiationProviderPid}}",
			"headers": {
				"authorization": "{{trustAuthorization}}",
				"accept": "application/ld+json"
			},
			"expectedStatus": 200
		},
		{
			"description": "POST /rights-management/negotiations/:id/request — consumer counter-request",
			"appendOrgParam": true,
			"method": "POST",
			"path": "/rights-management/negotiations/{{negotiationProviderPid}}/request",
			"headers": {
				"authorization": "{{trustAuthorization}}",
				"accept": "application/ld+json"
			},
			"body": {
				"@context": ["https://w3id.org/dspace/2025/1/context.jsonld"],
				"@type": "ContractRequestMessage",
				"providerPid": "{{negotiationProviderPid}}",
				"consumerPid": "urn:uuid:11111111-1111-1111-1111-111111111111",
				"callbackAddress": "https://example.com/callback",
				"offer": {
					"@type": "Offer",
					"@id": "{{offerPolicyId}}"
				}
			},
			"expectedStatus": 200
		},
		{
			"description": "POST /rights-management/negotiations/:id/termination — terminate negotiation",
			"appendOrgParam": true,
			"method": "POST",
			"path": "/rights-management/negotiations/{{negotiationProviderPid}}/termination",
			"headers": {
				"authorization": "{{trustAuthorization}}",
				"accept": "application/ld+json"
			},
			"body": {
				"@context": ["https://w3id.org/dspace/2025/1/context.jsonld"],
				"@type": "ContractNegotiationTerminationMessage",
				"providerPid": "{{negotiationProviderPid}}",
				"consumerPid": "urn:uuid:11111111-1111-1111-1111-111111111111"
			},
			"expectedStatus": 204
		},
		{
			"description": "POST /rights-management/negotiations/request — second negotiation for full flow",
			"appendOrgParam": true,
			"method": "POST",
			"path": "/rights-management/negotiations/request",
			"headers": {
				"authorization": "{{trustAuthorization}}",
				"accept": "application/ld+json"
			},
			"body": {
				"@context": ["https://w3id.org/dspace/2025/1/context.jsonld"],
				"@type": "ContractRequestMessage",
				"consumerPid": "urn:uuid:22222222-2222-2222-2222-222222222222",
				"offer": {
					"@type": "Offer",
					"@id": "{{offerPolicyId}}"
				}
			},
			"expectedStatus": 201,
			"capture": { "negotiation2ProviderPid": "body.providerPid" }
		},
		{
			"description": "POST /rights-management/negotiations/admin — pre-register consumer side for offers test",
			"method": "POST",
			"path": "/rights-management/negotiations/admin",
			"body": {
				"id": "urn:uuid:22222222-2222-2222-2222-222222222222"
			},
			"expectedStatus": 201
		},
		{
			"description": "POST /rights-management/negotiations/:id/offers — provider sends counter-offer",
			"appendOrgParam": true,
			"method": "POST",
			"path": "/rights-management/negotiations/{{negotiation2ProviderPid}}/offers",
			"headers": {
				"authorization": "{{trustAuthorization}}",
				"accept": "application/ld+json"
			},
			"body": {
				"@context": ["https://w3id.org/dspace/2025/1/context.jsonld"],
				"@type": "ContractOfferMessage",
				"providerPid": "{{negotiation2ProviderPid}}",
				"consumerPid": "urn:uuid:22222222-2222-2222-2222-222222222222",
				"offer": {
					"@type": "Offer",
					"@id": "{{offerPolicyId}}",
					"assigner": "urn:provider:node:test"
				}
			},
			"expectedStatus": 200
		},
		{
			"description": "POST /rights-management/negotiations/:id/events — consumer accepts offer",
			"appendOrgParam": true,
			"method": "POST",
			"path": "/rights-management/negotiations/{{negotiation2ProviderPid}}/events",
			"delayMs": 150,
			"headers": {
				"authorization": "{{trustAuthorization}}",
				"accept": "application/ld+json"
			},
			"body": {
				"@context": ["https://w3id.org/dspace/2025/1/context.jsonld"],
				"@type": "ContractNegotiationEventMessage",
				"providerPid": "{{negotiation2ProviderPid}}",
				"consumerPid": "urn:uuid:22222222-2222-2222-2222-222222222222",
				"event": "ACCEPTED"
			},
			"expectedStatus": 204
		},
		{
			"description": "POST /rights-management/negotiations/:id/agreement — provider sends agreement",
			"appendOrgParam": true,
			"method": "POST",
			"path": "/rights-management/negotiations/{{negotiation2ProviderPid}}/agreement",
			"headers": {
				"authorization": "{{trustAuthorization}}",
				"accept": "application/ld+json"
			},
			"body": {
				"@context": ["https://w3id.org/dspace/2025/1/context.jsonld"],
				"@type": "ContractAgreementMessage",
				"providerPid": "{{negotiation2ProviderPid}}",
				"consumerPid": "urn:uuid:22222222-2222-2222-2222-222222222222",
				"agreement": {
					"@type": "Agreement",
					"@id": "{{offerPolicyId}}",
					"assigner": "urn:provider:node:test",
					"assignee": "urn:consumer:node:test"
				}
			},
			"expectedStatus": 204
		},
		{
			"description": "POST /rights-management/negotiations/:id/agreement/verification — consumer verifies",
			"appendOrgParam": true,
			"delayMs": 150,
			"method": "POST",
			"path": "/rights-management/negotiations/{{negotiation2ProviderPid}}/agreement/verification",
			"headers": {
				"authorization": "{{trustAuthorization}}",
				"accept": "application/ld+json"
			},
			"body": {
				"@context": ["https://w3id.org/dspace/2025/1/context.jsonld"],
				"@type": "ContractAgreementVerificationMessage",
				"providerPid": "{{negotiation2ProviderPid}}",
				"consumerPid": "urn:uuid:22222222-2222-2222-2222-222222222222"
			},
			"expectedStatus": 204
		},
		{
			"description": "POST /rights-management/negotiations/admin — pre-register consumer side for initial offer test",
			"method": "POST",
			"path": "/rights-management/negotiations/admin",
			"body": {
				"id": "urn:uuid:33333333-3333-3333-3333-333333333333"
			},
			"expectedStatus": 201
		},
		{
			"description": "POST /rights-management/negotiations/offers — provider-initiated offer",
			"appendOrgParam": true,
			"method": "POST",
			"path": "/rights-management/negotiations/offers",
			"headers": {
				"authorization": "{{trustAuthorization}}",
				"accept": "application/ld+json"
			},
			"body": {
				"@context": ["https://w3id.org/dspace/2025/1/context.jsonld"],
				"@type": "ContractOfferMessage",
				"providerPid": "urn:uuid:44444444-4444-4444-4444-444444444444",
				"consumerPid": "urn:uuid:33333333-3333-3333-3333-333333333333",
				"offer": {
					"@type": "Offer",
					"@id": "{{offerPolicyId}}",
					"assigner": "urn:provider:node:test"
				}
			},
			"expectedStatus": 201
		},
		{
			"description": "POST /rights-management/negotiations/admin — pre-register consumer-side negotiation",
			"method": "POST",
			"path": "/rights-management/negotiations/admin",
			"body": {
				"id": "urn:uuid:55555555-5555-5555-5555-555555555555"
			},
			"expectedStatus": 201
		},
		{
			"description": "GET /rights-management/negotiations/admin",
			"method": "GET",
			"path": "/rights-management/negotiations/admin",
			"expectedStatus": 200,
			"capture": { "negotiationAdminId": "body.[0].id" }
		},
		{
			"description": "GET /rights-management/negotiations/admin/:id",
			"method": "GET",
			"path": "/rights-management/negotiations/admin/{{negotiationAdminId}}",
			"expectedStatus": 200,
			"capture": { "negotiationRecord": "body" }
		},
		{
			"description": "PUT /rights-management/negotiations/admin/:id",
			"method": "PUT",
			"path": "/rights-management/negotiations/admin/{{negotiationAdminId}}",
			"body": "{{negotiationRecord}}",
			"expectedStatus": 204
		},
		{
			"description": "DELETE /rights-management/negotiations/admin/:id",
			"method": "DELETE",
			"path": "/rights-management/negotiations/admin/{{negotiationAdminId}}",
			"expectedStatus": 204
		},
		{
			"description": "GET /rights-management/negotiations/admin/:id — 404 after delete",
			"method": "GET",
			"path": "/rights-management/negotiations/admin/{{negotiationAdminId}}",
			"expectedStatus": 404
		}
	]
}
