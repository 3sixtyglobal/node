{
	"group": "Health and Logout",
	"steps": [
		{
			"description": "GET /health — waits at least 5s since server start",
			"method": "GET",
			"path": "/health",
			"auth": false,
			"expectedStatus": 200,
			"healthBarrier": 5000
		},
		{
			"description": "POST /authentication/refresh",
			"method": "POST",
			"path": "/authentication/refresh",
			"expectedStatus": 200,
			"capture": { "authToken": "cookie:access_token" }
		},
		{
			"description": "POST /authentication/logout",
			"method": "POST",
			"path": "/authentication/logout",
			"expectedStatus": 204
		}
	]
}
