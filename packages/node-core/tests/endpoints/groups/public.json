{
	"group": "Public endpoints",
	"steps": [
		{
			"description": "GET /",
			"method": "GET",
			"path": "/",
			"auth": false,
			"appendOrgParam": false,
			"expectedStatus": 200
		},
		{
			"description": "GET /favicon.ico",
			"method": "GET",
			"path": "/favicon.ico",
			"auth": false,
			"appendOrgParam": false,
			"expectedStatus": 404
		},
		{
			"description": "GET /info",
			"method": "GET",
			"path": "/info",
			"auth": false,
			"expectedStatus": 200,
			"assert": { "body.name": "isDefined" }
		},
		{
			"description": "GET /spec",
			"method": "GET",
			"path": "/spec",
			"auth": false,
			"expectedStatus": 200,
			"assert": { "body.openapi": "isDefined" }
		},
		{
			"description": "GET /livez",
			"method": "GET",
			"path": "/livez",
			"auth": false,
			"expectedStatus": 200
		},
		{
			"description": "GET /readyz",
			"method": "GET",
			"path": "/readyz",
			"auth": false,
			"expectedStatus": 200
		}
	]
}
