{
	"group": "Global Admin - Unauthorised user cannot use override-tenant",
	"steps": [
		{
			"description": "POST /identity - create identity for regular test user",
			"method": "POST",
			"path": "/identity",
			"body": {},
			"expectedStatus": 200,
			"capture": { "regularUserDid": "body.id" }
		},
		{
			"description": "POST /authentication/admin/users - create user without global-admin role",
			"method": "POST",
			"path": "/authentication/admin/users",
			"body": { "email": "regular-user@node", "password": "Regular@Node12345!" },
			"expectedStatus": 201
		},
		{
			"description": "GET /authentication/admin/users/:email - capture the account id",
			"method": "GET",
			"path": "/authentication/admin/users/regular-user%40node",
			"expectedStatus": 200,
			"capture": { "regularAccountId": "body.accountId" }
		},
		{
			"description": "POST /authentication/admin/account - store the identity of the account",
			"method": "POST",
			"path": "/authentication/admin/account",
			"body": {
				"accountId": "{{regularAccountId}}",
				"type": "identity",
				"data": { "@context": "https://www.w3.org/ns/did/v1", "id": "{{regularUserDid}}" },
				"isDefault": true
			},
			"expectedStatus": 201
		},
		{
			"description": "POST /authorization/system/subject/:subject/role - assign tenant-admin role to the account",
			"method": "POST",
			"path": "/authorization/system/subject/{{regularAccountId}}/role",
			"body": { "role": "tenant-admin" },
			"expectedStatus": 204
		},
		{
			"description": "POST /authentication/login - login as regular user (no global-admin role)",
			"method": "POST",
			"path": "/authentication/login",
			"apiKey": true,
			"body": { "email": "regular-user@node", "password": "Regular@Node12345!" },
			"expectedStatus": 200,
			"capture": { "authToken": "cookie:access_token" }
		},
		{
			"description": "GET /authentication/admin/users/:email - rejected for user-only role",
			"method": "GET",
			"path": "/authentication/admin/users/{{adminEmail}}",
			"expectedStatus": 403
		},
		{
			"description": "POST /aig?override-tenant - rejected without global-admin role",
			"method": "POST",
			"path": "/aig?override-tenant={{secondTenantId}}",
			"body": {
				"@context": ["https://schema.3sixty.global/aig/", "https://schema.3sixty.global/common/"],
				"type": "AuditableItemGraphVertex"
			},
			"expectedStatus": 403
		},
		{
			"description": "POST /authentication/login - restore admin session",
			"method": "POST",
			"path": "/authentication/login",
			"apiKey": true,
			"body": { "email": "{{adminEmail}}", "password": "{{adminPassword}}" },
			"expectedStatus": 200,
			"capture": { "authToken": "cookie:access_token" }
		},
		{
			"description": "DELETE /authentication/admin/users - remove regular test user",
			"method": "DELETE",
			"path": "/authentication/admin/users/regular-user%40node",
			"expectedStatus": 204
		},
		{
			"description": "DELETE /identity/:identity - 404 as removing the user already removed its node held identity",
			"method": "DELETE",
			"path": "/identity/{{regularUserDid}}",
			"expectedStatus": 404
		}
	]
}
