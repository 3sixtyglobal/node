{
	"group": "Global Admin - Unauthorised user cannot use override-tenant",
	"steps": [
		{
			"description": "POST /identity - create identity for regular test user",
			"method": "POST",
			"path": "/identity",
			"body": {},
			"expectedStatus": 200,
			"capture": { "regularUserDid": "body.id" }
		},
		{
			"description": "POST /authentication/admin/users - create user without global-admin scope",
			"method": "POST",
			"path": "/authentication/admin/users",
			"body": {
				"email": "regular-user@node",
				"password": "Regular@Node12345!",
				"userIdentity": "{{regularUserDid}}",
				"organizationIdentity": "{{adminOrgIdentity}}",
				"scope": ["tenant-admin"]
			},
			"expectedStatus": 201
		},
		{
			"description": "POST /authentication/login - login as regular user (no global-admin scope)",
			"method": "POST",
			"path": "/authentication/login",
			"apiKey": true,
			"body": { "email": "regular-user@node", "password": "Regular@Node12345!" },
			"expectedStatus": 200,
			"capture": { "authToken": "cookie:access_token" }
		},
		{
			"description": "POST /aig?override-tenant - rejected without global-admin scope",
			"method": "POST",
			"path": "/aig?override-tenant={{secondTenantId}}",
			"body": {
				"@context": ["https://schema.3sixty.global/aig/", "https://schema.3sixty.global/common/"],
				"type": "AuditableItemGraphVertex"
			},
			"expectedStatus": 403
		},
		{
			"description": "POST /authentication/login - restore admin session",
			"method": "POST",
			"path": "/authentication/login",
			"apiKey": true,
			"body": { "email": "{{adminEmail}}", "password": "{{adminPassword}}" },
			"expectedStatus": 200,
			"capture": { "authToken": "cookie:access_token", "organizationId": "jwt-claim:org" }
		},
		{
			"description": "DELETE /authentication/admin/users - remove regular test user",
			"method": "DELETE",
			"path": "/authentication/admin/users/regular-user%40node",
			"expectedStatus": 204
		},
		{
			"description": "DELETE /identity/:regularUserDid - remove regular user identity",
			"method": "DELETE",
			"path": "/identity/{{regularUserDid}}",
			"expectedStatus": 204
		}
	]
}
