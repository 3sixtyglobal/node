{
	"group": "Global Admin - Cross-tenant override",
	"steps": [
		{
			"description": "POST /aig?override-tenant - create vertex in second tenant partition",
			"method": "POST",
			"path": "/aig?override-tenant={{secondTenantId}}",
			"body": {
				"@context": ["https://schema.twindev.org/aig/", "https://schema.twindev.org/common/"],
				"type": "AuditableItemGraphVertex"
			},
			"expectedStatus": 201,
			"capture": { "overriddenVertexId": "location-last-segment" }
		},
		{
			"description": "GET /aig/:id?override-tenant - read vertex from second tenant partition",
			"method": "GET",
			"path": "/aig/{{overriddenVertexId}}?override-tenant={{secondTenantId}}",
			"expectedStatus": 200,
			"assert": { "body.id": "isDefined" }
		},
		{
			"description": "GET /aig/:id (no override) - same id is absent in caller's own partition",
			"method": "GET",
			"path": "/aig/{{overriddenVertexId}}",
			"expectedStatus": 404
		}
	]
}
