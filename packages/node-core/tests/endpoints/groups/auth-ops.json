{
	"group": "Authentication Operations",
	"steps": [
		{
			"description": "PUT /authentication/password - 403 wrong current password",
			"method": "PUT",
			"path": "/authentication/password",
			"body": { "currentPassword": "Wrong@Password123456!", "newPassword": "NewPassword@123456!" },
			"expectedStatus": 403,
			"assert": { "body.message": "passwordHelper.currentPasswordMismatch" }
		},
		{
			"description": "GET /authentication/me - the session still works after a wrong current password",
			"method": "GET",
			"path": "/authentication/me",
			"expectedStatus": 200,
			"assert": { "body.email": "{{adminEmail}}" }
		},
		{
			"description": "GET /authentication/oauth/:provider/start - 404 for an unknown provider",
			"method": "GET",
			"path": "/authentication/oauth/unknown-provider/start",
			"expectedStatus": 404,
			"headers": { "cookie": "none=0" }
		},
		{
			"description": "PUT /authentication/password - new token for the current session",
			"method": "PUT",
			"path": "/authentication/password",
			"body": { "currentPassword": "{{adminPassword}}", "newPassword": "NewPassword@123456!" },
			"expectedStatus": 200,
			"assert": { "body.expiry": "isDefined" },
			"capture": { "authToken": "cookie:access_token" }
		},
		{
			"description": "GET /authentication/me - the current session continues",
			"method": "GET",
			"path": "/authentication/me",
			"expectedStatus": 200
		},
		{
			"description": "POST /authentication/login - re-login with new password",
			"method": "POST",
			"path": "/authentication/login",
			"apiKey": true,
			"body": { "email": "{{adminEmail}}", "password": "NewPassword@123456!" },
			"expectedStatus": 200,
			"capture": { "authToken": "cookie:access_token" }
		},
		{
			"description": "POST /authentication/audit - 400 missing event",
			"method": "POST",
			"path": "/authentication/audit",
			"body": {},
			"expectedStatus": 400
		},
		{
			"description": "POST /authentication/audit - create audit entry",
			"method": "POST",
			"path": "/authentication/audit",
			"body": { "event": "login-success" },
			"expectedStatus": 201,
			"capture": { "auditId": "location-last-segment" }
		},
		{
			"description": "GET /authentication/audit/:id",
			"method": "GET",
			"path": "/authentication/audit/{{auditId}}",
			"expectedStatus": 200
		},
		{
			"description": "PUT /authentication/audit/:id",
			"method": "PUT",
			"path": "/authentication/audit/{{auditId}}",
			"body": { "event": "logout-success" },
			"expectedStatus": 204
		},
		{
			"description": "DELETE /authentication/audit/:id",
			"method": "DELETE",
			"path": "/authentication/audit/{{auditId}}",
			"expectedStatus": 204
		},
		{
			"description": "GET /authentication/audit/:id - 404 after delete",
			"method": "GET",
			"path": "/authentication/audit/{{auditId}}",
			"expectedStatus": 404
		},
		{
			"description": "GET /authentication/audit",
			"method": "GET",
			"path": "/authentication/audit",
			"expectedStatus": 200
		}
	]
}
