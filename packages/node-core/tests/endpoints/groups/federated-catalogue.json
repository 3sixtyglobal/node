{
	"group": "Federated Catalogue",
	"steps": [
		{
			"description": "POST /catalog/datasets — create dataset",
			"method": "POST",
			"path": "/catalog/datasets",
			"headers": {
				"authorization": "{{trustAuthorization}}"
			},
			"body": {
				"@context": {
					"dcat": "http://www.w3.org/ns/dcat#",
					"dcterms": "http://purl.org/dc/terms/",
					"odrl": "http://www.w3.org/ns/odrl/2/"
				},
				"@id": "{{fedCatDatasetId}}",
				"@type": "dcat:Dataset",
				"dcterms:title": "Test Dataset",
				"dcterms:publisher": "https://example.com/publisher",
				"odrl:hasPolicy": [
					{
						"@context": "http://www.w3.org/ns/odrl.jsonld",
						"@type": "Offer",
						"uid": "urn:uuid:test-offer-endpoint-001",
						"assigner": "https://example.com/assigner",
						"permission": [{ "action": "use" }]
					}
				],
				"dcat:distribution": [
					{
						"@type": "dcat:Distribution",
						"dcterms:format": "HttpData-PULL",
						"dcat:accessService": "https://example.com/data-access"
					}
				]
			},
			"expectedStatus": 201
		},
		{
			"description": "POST /catalog/request — 400 missing @type",
			"method": "POST",
			"path": "/catalog/request",
			"headers": {
				"authorization": "{{trustAuthorization}}"
			},
			"body": {
				"@context": ["https://w3id.org/dspace/2025/1/context.jsonld"]
			},
			"expectedStatus": 400,
			"assert": { "body.@type": "CatalogError" }
		},
		{
			"description": "POST /catalog/request — 400 filter not an array",
			"method": "POST",
			"path": "/catalog/request",
			"headers": {
				"authorization": "{{trustAuthorization}}"
			},
			"body": {
				"@context": ["https://w3id.org/dspace/2025/1/context.jsonld"],
				"@type": "CatalogRequestMessage",
				"filter": "not-an-array"
			},
			"expectedStatus": 400,
			"assert": { "body.@type": "CatalogError" }
		},
		{
			"description": "GET /catalog/datasets/:datasetId — 200 known dataset",
			"method": "GET",
			"path": "/catalog/datasets/{{fedCatDatasetId}}",
			"headers": {
				"authorization": "{{trustAuthorization}}"
			},
			"expectedStatus": 200,
			"assert": { "body.@type": "Dataset" }
		},
		{
			"description": "GET /catalog/datasets/:datasetId — 404 unknown dataset",
			"method": "GET",
			"path": "/catalog/datasets/{{fakeId}}",
			"headers": {
				"authorization": "{{trustAuthorization}}"
			},
			"expectedStatus": 404,
			"assert": { "body.@type": "CatalogError" }
		},
		{
			"description": "DELETE /catalog/datasets/:datasetId — delete dataset",
			"method": "DELETE",
			"path": "/catalog/datasets/{{fedCatDatasetId}}",
			"headers": {
				"authorization": "{{trustAuthorization}}"
			},
			"expectedStatus": 204
		}
	]
}
