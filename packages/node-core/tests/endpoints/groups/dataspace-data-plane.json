{
	"group": "Dataspace - Data Plane",
	"steps": [
		{
			"description": "POST /dataspace/inbox - 400 missing @type (schema validation)",
			"method": "POST",
			"path": "/dataspace/inbox",
			"headers": {
				"authorization": "{{trustAuthorization}}"
			},
			"body": {
				"@context": "https://www.w3.org/ns/activitystreams"
			},
			"expectedStatus": 400
		},
		{
			"description": "GET /dataspace/activity-logs/:id - 404 unknown id",
			"method": "GET",
			"path": "/dataspace/activity-logs/{{fakeId}}",
			"headers": {
				"authorization": "{{trustAuthorization}}"
			},
			"expectedStatus": 404
		},
		{
			"description": "GET /dataspace/entities - 404 unknown consumerPid",
			"method": "GET",
			"path": "/dataspace/entities?consumerPid={{fakeId}}&type=https://vocabulary.uncefact.org/Consignment",
			"headers": {
				"authorization": "{{trustAuthorization}}"
			},
			"expectedStatus": 404
		},
		{
			"description": "POST /dataspace/entities/query - 404 unknown consumerPid",
			"method": "POST",
			"path": "/dataspace/entities/query",
			"headers": {
				"authorization": "{{trustAuthorization}}"
			},
			"body": {
				"consumerPid": "{{fakeId}}",
				"query": {
					"type": "https://vocabulary.uncefact.org/Consignment",
					"q": ""
				}
			},
			"expectedStatus": 404
		},
		{
			"description": "GET /dataspace/entities - 200 (STARTED transfer from transfers group)",
			"appendOrgParam": true,
			"method": "GET",
			"path": "/dataspace/entities?consumerPid={{transferConsumerPid}}&type=https://vocabulary.uncefact.org/Consignment",
			"headers": {
				"authorization": "{{trustAuthorization}}"
			},
			"expectedStatus": 200
		},
		{
			"description": "POST /dataspace/entities/query - 200",
			"appendOrgParam": true,
			"method": "POST",
			"path": "/dataspace/entities/query",
			"headers": {
				"authorization": "{{trustAuthorization}}"
			},
			"body": {
				"consumerPid": "{{transferConsumerPid}}",
				"query": {
					"type": "https://vocabulary.uncefact.org/Consignment",
					"q": ""
				}
			},
			"expectedStatus": 200
		},
		{
			"description": "POST /dataspace/transfers/:pid/complete - 200",
			"appendOrgParam": true,
			"method": "POST",
			"path": "/dataspace/transfers/{{transferProviderPid}}/complete",
			"headers": {
				"authorization": "{{trustAuthorization}}",
				"accept": "application/ld+json"
			},
			"body": {
				"@context": ["https://w3id.org/dspace/2025/1/context.jsonld"],
				"@type": "TransferCompletionMessage",
				"consumerPid": "{{transferConsumerPid}}",
				"providerPid": "{{transferProviderPid}}"
			},
			"expectedStatus": 200
		},
		{
			"description": "DELETE /dataspace/app-datasets/:id - 204",
			"method": "DELETE",
			"path": "/dataspace/app-datasets/{{dataspaceAppDatasetId}}",
			"expectedStatus": 204
		},
		{
			"description": "GET /dataspace/app-datasets/:id - 404 after delete",
			"method": "GET",
			"path": "/dataspace/app-datasets/{{dataspaceAppDatasetId}}",
			"expectedStatus": 404
		}
	]
}
