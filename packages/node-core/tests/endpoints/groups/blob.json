{
	"group": "Blob Storage",
	"steps": [
		{
			"description": "POST /blob — 400 missing blob field",
			"method": "POST",
			"path": "/blob",
			"body": {},
			"expectedStatus": 400
		},
		{
			"description": "POST /blob",
			"method": "POST",
			"path": "/blob",
			"body": { "blob": "dGVzdCBibG9iIGRhdGE=" },
			"expectedStatus": 201,
			"capture": { "blobId": "location-last-segment" }
		},
		{
			"description": "GET /blob/:id",
			"method": "GET",
			"path": "/blob/{{blobId}}",
			"expectedStatus": 200
		},
		{
			"description": "GET /blob/:id/content",
			"method": "GET",
			"path": "/blob/{{blobId}}/content",
			"expectedStatus": 200
		},
		{
			"description": "PUT /blob/:id",
			"method": "PUT",
			"path": "/blob/{{blobId}}",
			"body": { "blob": "dXBkYXRlZCBibG9iIGRhdGE=" },
			"expectedStatus": 204
		},
		{
			"description": "GET /blob",
			"method": "GET",
			"path": "/blob",
			"expectedStatus": 200
		},
		{
			"description": "DELETE /blob/:id",
			"method": "DELETE",
			"path": "/blob/{{blobId}}",
			"expectedStatus": 204
		},
		{
			"description": "GET /blob/:id — 404 after delete",
			"method": "GET",
			"path": "/blob/{{blobId}}",
			"expectedStatus": 404
		},
		{
			"description": "DELETE /blob — delete all",
			"method": "DELETE",
			"path": "/blob",
			"expectedStatus": 204
		}
	]
}
