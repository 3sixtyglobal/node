{
	"name": "@twin.org/node-core",
	"version": "0.10.1-next.9",
	"description": "TWIN Node Core for serving APIs using the specified configuration",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iotaledger/twin-node.git",
		"directory": "packages/node-core"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage",
		"build": "tspc",
		"dev": "nodemon --watch src --ext ts --exec \"pnpm run build\"",
		"merge-locales": "merge-locales",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"test:build": "tspc -p ./tests/tsconfig.json --noEmit",
		"validate-locales": "validate-locales",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc --options typedoc.config.mjs",
		"docs": "pnpm run docs:clean && pnpm run docs:generate",
		"dist": "pnpm run clean && concurrently -g -n build,merge,locales,types,test \"pnpm run build\" \"pnpm run merge-locales\" \"pnpm run validate-locales\" \"pnpm run test:build\" \"pnpm run test\"",
		"dist:no-test": "pnpm run clean && concurrently -g -n build,merge,locales,types \"pnpm run build\" \"pnpm run merge-locales\" \"pnpm run validate-locales\" \"pnpm run test:build\""
	},
	"dependencies": {
		"@twin.org/api-auth-entity-storage-models": "next",
		"@twin.org/api-auth-entity-storage-service": "next",
		"@twin.org/api-models": "next",
		"@twin.org/api-tenant-processor": "next",
		"@twin.org/auditable-item-graph-service": "next",
		"@twin.org/cli-core": "next",
		"@twin.org/context": "next",
		"@twin.org/core": "next",
		"@twin.org/crypto": "next",
		"@twin.org/data-json-ld": "next",
		"@twin.org/dlt-account": "next",
		"@twin.org/dlt-iota": "next",
		"@twin.org/engine": "next",
		"@twin.org/engine-core": "next",
		"@twin.org/engine-models": "next",
		"@twin.org/engine-server": "next",
		"@twin.org/engine-server-types": "next",
		"@twin.org/engine-types": "next",
		"@twin.org/entity": "next",
		"@twin.org/entity-storage-models": "next",
		"@twin.org/identity-connector-entity-storage": "next",
		"@twin.org/identity-models": "next",
		"@twin.org/logging-connector-opentelemetry": "next",
		"@twin.org/logging-models": "next",
		"@twin.org/modules": "next",
		"@twin.org/nameof": "next",
		"@twin.org/rights-management-pap-service": "next",
		"@twin.org/standards-w3c-did": "next",
		"@twin.org/standards-w3c-odrl": "next",
		"@twin.org/telemetry-connector-opentelemetry": "next",
		"@twin.org/tracing-connector-opentelemetry": "next",
		"@twin.org/tracing-facades": "next",
		"@twin.org/tracing-models": "next",
		"@twin.org/vault-models": "next",
		"@twin.org/wallet-connector-entity-storage": "next",
		"@twin.org/wallet-models": "next",
		"@twin.org/web": "next",
		"dotenv": "18.0.3",
		"schema-dts": "2.0.0"
	},
	"devDependencies": {
		"@twin.org/automation-models": "next",
		"@twin.org/data-core": "next",
		"@twin.org/dataspace-models": "next",
		"@twin.org/entity-storage-connector-memory": "next",
		"@twin.org/federated-catalogue-models": "next",
		"@twin.org/merge-locales": "next",
		"@twin.org/nameof-transformer": "next",
		"@twin.org/nameof-vitest-plugin": "next",
		"@twin.org/rights-management-models": "next",
		"@twin.org/telemetry-models": "next",
		"@twin.org/trust-models": "next",
		"@twin.org/ts-to-openapi": "next",
		"@twin.org/validate-locales": "next",
		"@types/node": "26.6.2",
		"@vitest/coverage-v8": "5.0.1",
		"concurrently": "10.0.5",
		"copyfiles": "2.4.1",
		"nodemon": "3.1.14",
		"rimraf": "6.1.3",
		"ts-patch": "4.0.1",
		"typedoc": "0.28.20",
		"typedoc-plugin-markdown": "4.13.1",
		"typescript": "6.0.3",
		"vitest": "5.0.1"
	},
	"main": "./dist/es/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/es/index.js",
			"default": "./dist/es/index.js"
		},
		"./locales/*.json": "./locales/*.json"
	},
	"files": [
		"dist/es",
		"dist/types",
		"locales",
		"docs"
	],
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"node",
		"core",
		"foundation",
		"utilities"
	],
	"bugs": {
		"url": "git+https://github.com/iotaledger/twin-node/issues"
	},
	"homepage": "https://twindev.org"
}
