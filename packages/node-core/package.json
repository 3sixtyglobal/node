{
	"name": "@twin.org/node-core",
	"version": "0.0.2-next.22",
	"description": "TWIN Node Core for serving APIs using the specified configuration",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/twinfoundation/node.git",
		"directory": "packages/node-core"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage docs/reference",
		"build": "tspc",
		"dev": "nodemon --watch src --ext ts --exec \"npm run build && npm run bundle:esm\"",
		"merge-locales": "merge-locales",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:build": "tspc -p ./tests/tsconfig.json --noEmit",
		"coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"bundle:esm": "rollup --config rollup.config.mjs --environment MODULE:esm",
		"bundle:cjs": "rollup --config rollup.config.mjs --environment MODULE:cjs",
		"bundle": "npm run bundle:esm && npm run bundle:cjs",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc",
		"docs": "npm run docs:clean && npm run docs:generate",
		"dist": "npm run clean && npm run build && npm run merge-locales && npm run test:build && npm run test && npm run bundle && npm run docs",
		"dist:no-test": "npm run clean && npm run build && npm run merge-locales && npm run bundle && npm run docs"
	},
	"dependencies": {
		"@twin.org/api-auth-entity-storage-service": "next",
		"@twin.org/core": "next",
		"@twin.org/cli-core": "next",
		"@twin.org/crypto": "next",
		"@twin.org/data-space-connector-models": "next",
		"@twin.org/engine": "next",
		"@twin.org/engine-core": "next",
		"@twin.org/engine-models": "next",
		"@twin.org/engine-server": "next",
		"@twin.org/engine-server-types": "next",
		"@twin.org/engine-types": "next",
		"@twin.org/entity": "next",
		"@twin.org/entity-storage-models": "next",
		"@twin.org/identity-models": "next",
		"@twin.org/modules": "next",
		"@twin.org/rights-management-rest-client": "next",
		"@twin.org/standards-w3c-odrl": "next",
		"@twin.org/vault-models": "next",
		"@twin.org/wallet-models": "next",
		"dotenv": "17.2.2",
		"schema-dts": "1.1.5"
	},
	"devDependencies": {
		"@twin.org/entity-storage-connector-memory": "next",
		"@twin.org/merge-locales": "next",
		"@twin.org/nameof-transformer": "next",
		"@twin.org/nameof-vitest-plugin": "next",
		"@twin.org/ts-to-openapi": "next",
		"@vitest/coverage-v8": "3.2.4",
		"copyfiles": "2.4.1",
		"nodemon": "3.1.10",
		"rimraf": "6.0.1",
		"rollup": "4.52.3",
		"ts-patch": "3.3.0",
		"typedoc": "0.28.13",
		"typedoc-plugin-markdown": "4.9.0",
		"typescript": "5.9.2",
		"vitest": "3.2.4"
	},
	"main": "./dist/cjs/index.cjs",
	"module": "./dist/esm/index.mjs",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"require": "./dist/cjs/index.cjs",
			"import": "./dist/esm/index.mjs"
		},
		"./locales/*.json": "./locales/*.json"
	},
	"files": [
		"dist/cjs",
		"dist/esm",
		"dist/types",
		"locales",
		"docs"
	],
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"node",
		"core",
		"foundation",
		"utilities"
	]
}
